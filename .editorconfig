root = true

[*.cs]
# end_of_line is pinned to LF (with .gitattributes `* text=auto eol=lf`) because the index is
# already LF for every source file: leaving it automatic made `dotnet format --verify-no-changes`
# platform-dependent (a CRLF checkout reports four EOL-only "fixes" on a tree whose content is
# identical), which is exactly the non-reproducibility this phase removes.
# charset stays absent — 102 of 820 files carry a UTF-8 BOM and the rest do not; any value forces
# a wholesale rewrite of the majority.
end_of_line = lf
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true
