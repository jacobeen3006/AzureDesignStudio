<Project>
  <!-- MAUI's BundledVersions.targets assigns MauiVersion in the inner (per-target-framework)
       build, so the outer evaluation sees it empty; and Directory.Build.props is imported
       before Directory.Packages.props. The pin has to live here, or the two central MAUI
       rows in Directory.Packages.props evaluate to an empty version. -->
  <PropertyGroup>
    <MauiVersion>10.0.110</MauiVersion>
    <!-- One lock file per project, written by restore and committed, so the resolved graph is
         reviewable and drift is visible. Locked mode itself is a CI flag passed to restore on the
         command line, never a repository property: forcing it here would demand a forced
         re-evaluation on every local package edit. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Measured basis: a clean Release rebuild of all 11 projects emits zero compiler, NuGet,
         analyzer, or MSBuild warnings, so this is a no-op today that keeps it that way. The 91
         remaining warnings are WinAppSDK resource-packaging task warnings (PRI263); this is a
         Roslyn switch, so it does not promote them. The MSBuild-level task-warning switch is
         deliberately left unset: it would turn that resource-packaging quirk into a failure. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- Vulnerability gate: only High and Critical advisories are reported at all, so only they can
       fail (NU1903/NU1904, promoted by TreatWarningsAsErrors above). Reporting lower severities
       would break every developer's local build on a moderate advisory the team has not chosen to
       act on. The two per-project NoWarn blocks that used to silence the audit code were deleted
       with the suppression item below: a local NoWarn would bypass this gate in exactly the two
       projects that consume AutoMapper. -->
  <PropertyGroup>
    <NuGetAuditLevel>high</NuGetAuditLevel>
    <!-- Measured: the SDK defaults the mode to all only for .NETCoreApp 10.0+, so the
         netstandard2.0 SourceGeneration project audits direct dependencies only unless this is
         set. With plan 02-01's System.Security.Cryptography.Xml 10.0.13 pin in place, all adds no
         advisory beyond AutoMapper's. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Read by AdsCheckAuditSuppressionExpiry in Directory.Build.targets. -->
    <AdsAuditSuppressionAutoMapperExpires>2027-01-31</AdsAuditSuppressionAutoMapperExpires>
  </PropertyGroup>
  <ItemGroup>
    <!-- The single advisory exception in this repository. AutoMapper 12.0.1 carries
         GHSA-rvv3-g6hj-g44x (denial of service via uncontrolled recursion); 13+ requires a
         commercial licence key, so the replacement is Phase 8's work. The suppression is
         advisory-scoped rather than package-scoped: any other package sharing that advisory would
         also be silenced. It is not open-ended — AdsCheckAuditSuppressionExpiry fails restore and
         build once AdsAuditSuppressionAutoMapperExpires has passed. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
  </ItemGroup>
</Project>
