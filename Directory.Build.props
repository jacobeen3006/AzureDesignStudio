<Project>

  <!-- MAUI's BundledVersions.targets sets $(MauiVersion) only in the inner
       (per-TFM) Desktop build; the outer multi-target evaluation sees it empty.
       Directory.Build.props is evaluated before Directory.Packages.props, so
       the pin must live here for the two MAUI central package rows to resolve. -->
  <PropertyGroup>
    <MauiVersion>10.0.110</MauiVersion>
    <!-- One packages.lock.json per project is required. Locked mode is a CI
         restore flag, never a repository property. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Measured baseline: zero compiler, NuGet, analyzer, and MSBuild warnings;
         the 91 PRI263 warnings are WinAppSDK task warnings and are deliberately
         not promoted. No MSBuildTreatWarningsAsErrors, WarningsAsErrors, NoWarn,
         CodeAnalysisTreatWarningsAsErrors, or EnforceCodeStyleInBuild. -->
  </PropertyGroup>

</Project>