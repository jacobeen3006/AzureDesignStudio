<Project>
  <!-- MAUI's BundledVersions.targets assigns MauiVersion in the inner (per-target-framework)
       build, so the outer evaluation sees it empty; and Directory.Build.props is imported
       before Directory.Packages.props. The pin has to live here, or the two central MAUI
       rows in Directory.Packages.props evaluate to an empty version. -->
  <PropertyGroup>
    <MauiVersion>10.0.110</MauiVersion>
    <!-- One lock file per project, written by restore and committed, so the resolved graph is
         reviewable and drift is visible. Locked mode itself is a CI flag passed to restore on the
         command line, never a repository property: forcing it here would demand a forced
         re-evaluation on every local package edit. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
