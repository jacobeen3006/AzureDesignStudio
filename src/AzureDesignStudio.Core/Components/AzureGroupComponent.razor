@using AzureDesignStudio.Core.Models
@using Blazor.Diagrams
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Components.Renderers
@using Blazor.Diagrams.Core.Models
@using Microsoft.Extensions.Configuration
@inject IConfiguration configuration

<div class="@Group.CssClassName" style="@Group.CssStyle">
    @if (!string.IsNullOrEmpty(Group.ImagePath))
    {
        <img src="@(configuration["ResourceRoot"] + Group.ImagePath)" alt=@Group.Name draggable="false" />
    }
    <span class="title">@Group.Name</span>
    @if (Group.ArmId.Length > 0)
    {
        <Tooltip Title="Linked to a live Azure resource (adopted from a scan). A refresh updates its facts.">
            <Icon Type="link" Theme="@IconThemeType.Outline" Class="ads-node-live" />
        </Tooltip>
    }
    @if (!Group.IsValid)
    {
        <Icon Type="exclamation-circle" Theme="@IconThemeType.Fill" Class="ads-node-status"/>
    }
    @foreach (var port in Group.Ports)
    {
        <PortRenderer Port="port" Class="ads-port"></PortRenderer>
    }
    <GroupNodes Group="Group"></GroupNodes>
</div>

@code {
    [Parameter]
    public AzureGroupBase Group { get; set; } = null!;
}
