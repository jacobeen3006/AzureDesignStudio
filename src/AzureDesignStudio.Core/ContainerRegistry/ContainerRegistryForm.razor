@using AzureDesignStudio.Core.Components
@using Blazor.Diagrams.Core
@using Blazor.Diagrams.Core.Models

<Form Model="@registry" LabelCol="@(new ColLayoutParam { Span = 8 })" WrapperCol="@(new ColLayoutParam { Span = 16 })" Size="@FormSize.Small">
    <NameAndLocation Node="@context" />
    <FormItem>
        <RadioGroup @bind-Value="@context.Sku" ButtonStyle="@RadioButtonStyle.Solid" Size="@InputSize.Small">
            <Radio RadioButton Value="@("Basic")">Basic</Radio>
            <Radio RadioButton Value="@("Standard")">Standard</Radio>
            <Radio RadioButton Value="@("Premium")">Premium</Radio>
        </RadioGroup>
    </FormItem>
    <FormItem>
        <RadioGroup @bind-Value="@context.AdminUserEnabled" ButtonStyle="@RadioButtonStyle.Solid" Size="@InputSize.Small">
            <Radio Value="true">Enabled</Radio>
            <Radio Value="false">Disabled</Radio>
        </RadioGroup>
    </FormItem>
</Form>

@code {
    [CascadingParameter]
    public NodeModel Node { get; set; } = null!;
    [CascadingParameter]
    public Diagram Diagram { get; set; } = null!;

    private ContainerRegistryModel registry => (ContainerRegistryModel)Node;
}
