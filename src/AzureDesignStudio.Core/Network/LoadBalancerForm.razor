@using AzureDesignStudio.Core.Components
@using Blazor.Diagrams.Core
@using Blazor.Diagrams.Core.Models

<Form Model="@lb" LabelCol="@(new ColLayoutParam { Span = 8 })" WrapperCol="@(new ColLayoutParam { Span = 16 })" Size="@FormSize.Small">
    <NameAndLocation Node="@context" />
    <FormItem>
        <RadioGroup @bind-Value="@context.Sku" ButtonStyle="@RadioButtonStyle.Solid" Size="@InputSize.Small">
            <Radio RadioButton Value="@("Standard")">Standard</Radio>
            <Radio RadioButton Value="@("Basic")">Basic</Radio>
        </RadioGroup>
    </FormItem>
    <FormItem>
        <Input Placeholder="frontend name" TValue="string" Size="@InputSize.Small"
            @bind-Value="@context.FrontendName"></Input>
    </FormItem>
    <FormItem>
        <Input Placeholder="backend pool name" TValue="string" Size="@InputSize.Small"
            @bind-Value="@context.BackendPoolName"></Input>
    </FormItem>
</Form>

@code {
    [CascadingParameter]
    public NodeModel Node { get; set; } = null!;
    [CascadingParameter]
    public Diagram Diagram { get; set; } = null!;

    private LoadBalancerModel lb => (LoadBalancerModel)Node;
}
