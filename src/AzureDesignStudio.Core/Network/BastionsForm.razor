@using AzureDesignStudio.Core.Models
@using Blazor.Diagrams.Core
@using Blazor.Diagrams.Core.Models
@using AzureDesignStudio.Core.Components

<Form Model="@bastion" LabelCol="@(new ColLayoutParam { Span = 6 })" WrapperCol="@(new ColLayoutParam { Span = 18 })" Size="@FormSize.Small">
    <NameAndLocation Node="@context" />
    @if (context.Group is not SubnetModel subnet || !subnet.Name.Equals("AzureBastionSubnet"))
    {
        <FormItem>
            <Alert Type="@AlertType.Warning" ShowIcon
                   Message="Place this bastion inside an AzureBastionSubnet. Drop it directly on a Virtual Network to create the subnet automatically." />
        </FormItem>
    }
    @if (!context.HasPublicIp)
    {
        <FormItem>
            <Alert Type="@AlertType.Warning" ShowIcon
                   Message="Link a Public IP to the bastion before exporting." />
        </FormItem>
    }
@*    <FormItem>
        <RadioGroup @bind-Value="@context.Sku" ButtonStyle="@RadioButtonStyle.Solid" Size="small">
            <Radio RadioButton Value="@("Basic")">Basic</Radio>
            <Radio RadioButton Value="@("Standard")">Standard</Radio>
        </RadioGroup>
    </FormItem>
    <FormItem>
        <InputNumber DefaultValue="2" @bind-Value="@context.ScaleUnits" Size="small"></InputNumber>
    </FormItem>*@
</Form>

@code {
    [CascadingParameter]
    public NodeModel Node { get; set; } = null!;
    [CascadingParameter]
    public Diagram Diagram { get; set; } = null!;

    private BastionsModel bastion => (BastionsModel)Node;
}
