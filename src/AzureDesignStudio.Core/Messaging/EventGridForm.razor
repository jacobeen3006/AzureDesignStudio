@using AzureDesignStudio.Core.Components
@using Blazor.Diagrams.Core
@using Blazor.Diagrams.Core.Models

<Form Model="@eventGrid" LabelCol="@(new ColLayoutParam { Span = 8 })" WrapperCol="@(new ColLayoutParam { Span = 16 })" Size="@FormSize.Small">
    <NameAndLocation Node="@context" />
    <FormItem>
        <RadioGroup @bind-Value="@context.InputSchema" ButtonStyle="@RadioButtonStyle.Solid" Size="@InputSize.Small">
            <Radio RadioButton Value="@("EventGrid")">EventGrid</Radio>
            <Radio RadioButton Value="@("CloudEvent")">CloudEvent</Radio>
            <Radio RadioButton Value="@("CustomResource")">CustomResource</Radio>
        </RadioGroup>
    </FormItem>
</Form>

@code {
    [CascadingParameter]
    public NodeModel Node { get; set; } = null!;
    [CascadingParameter]
    public Diagram Diagram { get; set; } = null!;

    private EventGridModel eventGrid => (EventGridModel)Node;
}
