@using AzureDesignStudio.Core.Components
@using Blazor.Diagrams.Core
@using Blazor.Diagrams.Core.Models

<Form Model="@containerInstance" LabelCol="@(new ColLayoutParam { Span = 8 })" WrapperCol="@(new ColLayoutParam { Span = 16 })" Size="@FormSize.Small">
    <NameAndLocation Node="@context" />
    <FormItem Label="OS type">
        <RadioGroup @bind-Value="@context.OsType" ButtonStyle="@RadioButtonStyle.Solid" Size="@InputSize.Small">
            <Radio RadioButton Value="@("Linux")">Linux</Radio>
            <Radio RadioButton Value="@("Windows")">Windows</Radio>
        </RadioGroup>
    </FormItem>
    <FormItem Label="CPU">
        <RadioGroup @bind-Value="@context.Cpu" ButtonStyle="@RadioButtonStyle.Solid" Size="@InputSize.Small">
            <Radio RadioButton Value="@("0.5")">0.5</Radio>
            <Radio RadioButton Value="@("1.0")">1.0</Radio>
            <Radio RadioButton Value="@("2.0")">2.0</Radio>
        </RadioGroup>
    </FormItem>
    <FormItem Label="Memory (GB)">
        <RadioGroup @bind-Value="@context.MemoryInGb" ButtonStyle="@RadioButtonStyle.Solid" Size="@InputSize.Small">
            <Radio RadioButton Value="@("1.5")">1.5</Radio>
            <Radio RadioButton Value="@("3.5")">3.5</Radio>
            <Radio RadioButton Value="@("7")">7</Radio>
        </RadioGroup>
    </FormItem>
</Form>

@code {
    [CascadingParameter]
    public NodeModel Node { get; set; } = null!;
    [CascadingParameter]
    public Diagram Diagram { get; set; } = null!;

    private ContainerInstanceModel containerInstance => (ContainerInstanceModel)Node;
}
