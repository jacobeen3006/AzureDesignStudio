@using AzureDesignStudio.Core.Models
@using Blazor.Diagrams.Core
@using Blazor.Diagrams.Core.Models
@using AzureDesignStudio.Core.Components

<Form Model="@aks" LabelCol="@(new ColLayoutParam { Span = 8 })" WrapperCol="@(new ColLayoutParam { Span = 16 })" Size="@FormSize.Small">
    <NameAndLocation Node="@context" />
    <FormItem>
        <Input TValue="string" Size="@InputSize.Small" @bind-Value="@context.DnsPrefix" Placeholder="DNS prefix (blank = derived from name)"></Input>
    </FormItem>
    <FormItem>
        <InputNumber @bind-Value="@context.NodeCount" Min="1" Max="100" Size="@InputSize.Small"></InputNumber>
    </FormItem>
    <FormItem>
        <Input TValue="string" Size="@InputSize.Small" @bind-Value="@context.AgentVmSize" Placeholder="Agent VM size"></Input>
    </FormItem>
    <FormItem>
        <Input TValue="string" Size="@InputSize.Small" @bind-Value="@context.KubernetesVersion" Placeholder="Kubernetes version (blank = ARM default)"></Input>
    </FormItem>
</Form>

@code {
    [CascadingParameter]
    public NodeModel Node { get; set; } = null!;
    [CascadingParameter]
    public Diagram Diagram { get; set; } = null!;

    private AksClusterModel aks => (AksClusterModel)Node;
}
