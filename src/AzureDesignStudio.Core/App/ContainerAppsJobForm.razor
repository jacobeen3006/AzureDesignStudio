@using AzureDesignStudio.Core.Components
@using Blazor.Diagrams.Core
@using Blazor.Diagrams.Core.Models

<Form Model="@job" LabelCol="@(new ColLayoutParam { Span = 8 })" WrapperCol="@(new ColLayoutParam { Span = 16 })" Size="@FormSize.Small">
    <NameAndLocation Node="@context" />
    <FormItem>
        <RadioGroup @bind-Value="@context.TriggerType" ButtonStyle="@RadioButtonStyle.Solid" Size="@InputSize.Small">
            <Radio RadioButton Value="@("Manual")">Manual</Radio>
            <Radio RadioButton Value="@("Schedule")">Schedule</Radio>
        </RadioGroup>
    </FormItem>
    @if (context.TriggerType == "Schedule")
    {
        <FormItem>
            <Input Placeholder="0 * * * *" @bind-Value="@context.Schedule" Size="@InputSize.Small" />
        </FormItem>
    }
    <FormItem>
        <Input @bind-Value="@context.Image" Size="@InputSize.Small" />
    </FormItem>
</Form>

@code {
    [CascadingParameter]
    public NodeModel Node { get; set; } = null!;
    [CascadingParameter]
    public Diagram Diagram { get; set; } = null!;

    private ContainerAppsJobModel job => (ContainerAppsJobModel)Node;
}
