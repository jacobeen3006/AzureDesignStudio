<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- One target per host OS: Windows builds the WinUI app, macOS builds the Mac Catalyst
             app. Each OS restores its own target only, so each has its own lock file - the
             Windows one stays packages.lock.json (CI restores it in locked mode on windows-latest). -->
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('osx'))">net10.0-windows10.0.19041.0</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst</TargetFrameworks>
        <NuGetLockFilePath Condition="$([MSBuild]::IsOSPlatform('osx'))">packages.maccatalyst.lock.json</NuGetLockFilePath>
        <!-- The Mac Catalyst SDK names one exact Xcode (27.0 today) and refuses any other; a point
             release of the same major (27.x) builds the same app. -->
        <ValidateXcodeVersion Condition="$([MSBuild]::IsOSPlatform('osx'))">false</ValidateXcodeVersion>
        <!-- No trimming in the Mac Release build: EF Core, AutoMapper and the Blazor component
             model resolve framework types by reflection, and the Windows app ships untrimmed too. -->
        <MtouchLink Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">None</MtouchLink>
        <!-- Release Mac Catalyst code is AOT-compiled with dynamic code switched off, and EF Core
             (deploy.db) then refuses to build its model at run time; AutoMapper and Blazor compile
             expressions too. The interpreter turns dynamic code back on and runs only that code. -->
        <UseInterpreter Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">true</UseInterpreter>

        <OutputType>Exe</OutputType>
        <RootNamespace>AzureDesignStudio.Desktop</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Disable MAUI CSS handling so Blazor can handle it -->
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>AzureDesignStudio.Desktop</ApplicationTitle>

        <!-- The bundle name Finder, the Dock and the menu bar show. Windows keeps the old title:
             its unpackaged app-data folder is derived from it, and renaming would orphan workspace.db. -->
        <ApplicationTitle Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">Azure Design Studio</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.azuredesignstudio.desktop</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

        <!-- Images -->

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Identity" />
        <PackageReference Include="Microsoft.Identity.Client" />
        <!-- WAM (the Windows broker) only; macOS signs in through the system browser. -->
        <PackageReference Include="Microsoft.Identity.Client.Broker" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <!-- Pin: this graph is one of only two that resolve transitive System.Security.Cryptography.Xml 10.0.10 (three high advisories); 10.0.13 is the first clean servicing release — a direct reference is the narrow fix, transitive pinning would fail restore with NU1109. -->
        <PackageReference Include="System.Security.Cryptography.Xml" />
    </ItemGroup>

    <ItemGroup>
        <!-- A universal (arm64 + x64) Mac build runs one inner build per architecture with
             AppendRuntimeIdentifierToOutputPath=true; passed on to the web client, whose RID is
             browser-wasm, it moves the client's static web asset manifest to obj/.../browser-wasm/,
             where nothing ever built it. The client is built once, before those inner builds. -->
        <ProjectReference Include="..\AzureDesignStudio\AzureDesignStudio.csproj" GlobalPropertiesToRemove="AppendRuntimeIdentifierToOutputPath" />
        <ProjectReference Include="..\AzureDesignStudio.Workspace\AzureDesignStudio.Workspace.csproj" />
        <ProjectReference Include="..\AzureDesignStudio.Discovery\AzureDesignStudio.Discovery.csproj" />
    <ProjectReference Include="..\AzureDesignStudio.Services\AzureDesignStudio.Services.csproj" />
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\AzureDesignStudio\wwwroot\ads-stencils.json" Link="ads-stencils.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- macOS: appsettings.json goes to the bundle's Contents/Resources (as Content, with the Razor
         SDK's CopyToOutputDirectory, the Apple build resolves it outside the bundle and drops it).
         The palette is read from the client's wwwroot copy, already bundled with the web assets. -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
        <Content Remove="appsettings.json;$(NuGetLockFilePath)" />
        <BundleResource Include="appsettings.json" LogicalName="appsettings.json" />
    </ItemGroup>

    <!-- Analyzer donor from the referenced WASM app's Azure.Bicep.Decompiler; keep out. -->
    <Target Name="DropForeignThreadingAnalyzers" BeforeTargets="CoreCompile">
        <ItemGroup>
            <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'Microsoft.VisualStudio.Threading.Analyzers'" />
        </ItemGroup>
    </Target>

</Project>
