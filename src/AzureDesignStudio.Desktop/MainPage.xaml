<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AzureDesignStudio.Desktop"
             xmlns:ads="clr-namespace:AzureDesignStudio"
             x:Class="AzureDesignStudio.Desktop.MainPage">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/app.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type ads:App}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
