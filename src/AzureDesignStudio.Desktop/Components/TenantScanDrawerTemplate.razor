    // v2 12.3 scan plane: read-only stacks listing + drift verdict. The scan's own snapshot
    // rows are the live side of CheckDrift - the same Inventory source, never a fresh ARM
    // sweep; the managed side is exactly what the stack GET/list payload reports.
    private async Task LoadStacksScopeAsync()
    {
        stackRows = [];
        stackListedSub = null;
        stacksError = null;
        stackSubs = stacksScanId is null ? [] : await ScanSubscriptionsAsync(stacksScanId);
        stackSubId = stackSubs.Count > 0 ? stackSubs[0] : "";
    }

    private async Task ListStacksAsync()
    {
        if (stacksScanId is null || stacksBusy || string.IsNullOrEmpty(stackSubId)) return;
        stacksBusy = true;
        stacksError = null;
        stackRows = [];
        try
        {
            var elements = await Stacks.ListAtSubscriptionAsync(stackSubId);
            var liveIds = (await Session.GetSnapshotsAsync(stacksScanId))
                .Where(r => string.Equals(r.SubscriptionId, stackSubId, StringComparison.OrdinalIgnoreCase))
                .Select(r => r.ResourceId).ToList();
            var cards = new List<StackCard>();
            foreach (var el in elements)
            {
                var id = StackStr(el, "id");
                var name = StackStr(el, "name");
                var state = el.TryGetProperty("properties", out var props) && props.ValueKind == JsonValueKind.Object
                    && props.TryGetProperty("provisioningState", out var ps) && ps.ValueKind == JsonValueKind.String
                    ? ps.GetString() ?? "" : "";
                var (ids, diags) = DeploymentStack.ReadManagedResources(el.GetRawText());
                // An unreadable managed list never gets a drift verdict - the card says why.
                var drift = diags.Any(d => d.Severity == ArmDiagnosticSeverity.Error)
                    ? (StackDriftReport?)null
                    : DeploymentStack.CheckDrift(ids, liveIds);
                cards.Add(new StackCard(string.IsNullOrEmpty(name) ? id : name, StackGroupFromId(id),
                    StackStr(el, "location"), state, ids.Count, drift, diags));
            }
            stackRows = cards;
            stackListedSub = stackSubId;
        }
        catch (Exception e)
        {
            // Errors surface as a row, never as a silently empty list.
            stacksError = e is ResourceGraphException rex ? $"HTTP {rex.StatusCode}: {rex.Code}" : e.Message;
        }
        stacksBusy = false;
    }

    private static string StackStr(JsonElement el, string name) =>
        el.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";

    // /subscriptions/{sub}/resourceGroups/{rg}/... - a stack without a group segment
    // (subscription/MG scope) honestly shows no group, never a guessed one.
    private static string StackGroupFromId(string id)
    {
        var parts = id.Split('/', StringSplitOptions.RemoveEmptyEntries);
        for (var i = 0; i < parts.Length - 1; i++)
            if (string.Equals(parts[i], "resourceGroups", StringComparison.OrdinalIgnoreCase))
                return parts[i + 1];
        return "";
    }

    private static string DriftKindColor(StackDriftKind kind) => kind switch
    {
        StackDriftKind.Synced => "green",
        StackDriftKind.Untracked => "red",
        _ => "orange",
    };

    // Adopt [12.2]: the filtered scan rows become an editable design. Saved in the server
    // design shape (the same DiagramGraph JSON TopMenu.LoadDiagram reads, not the .ads.json
    // text format), then opened on the canvas; unknown types stay as placeholder nodes.
    private async Task AdoptAsync()
    {
        if (browseScanId is null || adoptBusy)
            return;
        var items = Filtered().ToList();
        if (items.Count == 0 || items.Count > AdoptLimit)
            return;
        // Never destroy unsaved canvas work without an explicit yes: adoption clears both the
        // diagram and its undo history, and the replaced design stays only as the user saved it.
        if (adsContext.Diagram.Nodes.Count + adsContext.Diagram.Links.Count + adsContext.Diagram.Groups.Count > 0)
        {
            if (!await Modal.ConfirmAsync(new ConfirmOptions
            {
                Title = "Replace the design on the canvas?",
                Content = $"Adoption clears '{adsContext.CurrentDesignName ?? "the current design"}' and its undo history - save it first if it holds unsaved work.",
                OkType = ButtonType.Primary,
                OkText = "Replace",
                CancelText = "Cancel",
            }))
                return;
        }

        adoptBusy = true;
        try
        {
            var icons = BuildIconIndex();
            var adoption = AdoptEngine.Adopt(items.Select(ToAdoptable), key => icons.GetValueOrDefault(key));
            var designName = $"adopted-{browseScanId}";
            var status = await designService.SaveDesign(designName, JsonSerializer.Serialize(adoption.Graph));
            if (status != 200)
            {
                Message.Error("The adopted design could not be saved; the canvas is unchanged.");
                return;
            }

            // Open it with the TopMenu.LoadDiagram contract: history tracks user edits only.
            ReloadCanvas(adoption.Graph);
            adsContext.CurrentDesignName = designName;

            var placeholders = adoption.Items.Count(x => !x.Mapped);
            Message.Success($"Adopted {adoption.Items.Count} resource(s)"
                + (placeholders > 0 ? $", {placeholders} unknown type(s) kept as placeholders" : "")
                + $" into design '{designName}'.");
            if (FeedbackRef as DrawerRef<string> is { } dr)
                await dr.CloseAsync(string.Empty);
        }
        catch (Exception e)
        {
            // A dead circuit looks exactly like a frozen drawer; report instead.
            Message.Error($"Adoption failed: {e.Message}");
        }
        finally
        {
            adoptBusy = false;
        }
    }

    private Dictionary<string, string> BuildIconIndex() => (adsContext.AllStencils ?? [])
        .GroupBy(s => s.Key, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.First().IconPath, StringComparer.OrdinalIgnoreCase);

    private static string NormId(string id) => id.Trim().TrimStart('/');

    private static AdoptableResource ToAdoptable(InventoryItem i) =>
        new(i.Id, i.Type, i.Name, string.IsNullOrWhiteSpace(i.Location) ? null : i.Location);

    private DesignState? StateOf(InventoryItem item) =>
        reconcile is not null && stateById.TryGetValue(NormId(item.Id), out var st) ? st : null;

    private int NewInFilteredCount =>
        reconcile is null ? 0 : Filtered().Count(i => StateOf(i) == DesignState.InLiveNotDesign);

    // Snapshot the canvas and classify every browse row against it. Pure read of the
    // diagram; runs between renders on the UI thread.
    private async Task RecomputeReconcileAsync()
    {
        reconcile = null;
        stateById = new(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrEmpty(adsContext.CurrentDesignName) || browseItems.Count == 0)
            return;
        var intent = await DataModelFactory.SaveDiagramToDto(adsContext.Diagram, mapper);
        var report = ReconcileEngine.Reconcile(intent, browseItems.Select(ToAdoptable));
        reconcile = report;
        foreach (var r in report.Rows)
            stateById[r.Id] = r.State;
    }

    // The adopt verb of reconcile [58]: add ONLY the live-only rows of the current filter -
    // a live-plane merge restricted to the untracked subset, so nothing matched is touched
    // and no delete/update verb exists here. Ordinary save + canvas reload; the drawer
    // stays open and the chips reclassify immediately.
    private async Task AddNewToDesignAsync()
    {
        if (browseScanId is null || adoptBusy)
            return;
        var designName = adsContext.CurrentDesignName;
        if (string.IsNullOrEmpty(designName))
            return;
        var items = Filtered().Where(i => StateOf(i) == DesignState.InLiveNotDesign).ToList();
        if (items.Count == 0 || items.Count > AdoptLimit)
            return;
        if (!await Modal.ConfirmAsync(new ConfirmOptions
        {
            Title = "Add the new resources to the design?",
            Content = $"Adds {items.Count} resource(s) from this scan to '{designName}'. Nothing is moved or deleted; the undo history resets.",
            OkType = ButtonType.Primary,
            OkText = "Add",
            CancelText = "Cancel",
        }))
            return;

        adoptBusy = true;
        try
        {
            var intent = await DataModelFactory.SaveDiagramToDto(adsContext.Diagram, mapper);
            var icons = BuildIconIndex();
            var merged = LivePlaneMerger.Merge(intent, items.Select(ToAdoptable), key => icons.GetValueOrDefault(key));
            var status = await designService.SaveDesign(designName, JsonSerializer.Serialize(merged.Graph));
            if (status != 200)
            {
                Message.Error("The design could not be saved; the canvas is unchanged.");
                return;
            }

            ReloadCanvas(merged.Graph);
            await RecomputeReconcileAsync();
            Message.Success($"Added {merged.Added.Count} resource(s) to '{designName}'.");
        }
        finally
        {
            adoptBusy = false;
        }
    }

    // Reload the canvas from a freshly saved graph; the load itself is not an undoable edit.
    private void ReloadCanvas(DiagramGraph graph)
    {
        adsContext.Diagram.History.Suspend(() =>
        {
            adsContext.Diagram.Nodes.Clear();
            adsContext.Diagram.Links.Clear();
            adsContext.Diagram.Groups.Clear();
        });
        adsContext.Diagram.History.Suspend(() =>
            DataModelFactory.LoadDiagramFromDto(adsContext.Diagram, graph, mapper));
        adsContext.Diagram.History.Clear();
    }

    // Live-plane refresh [12.1]: fold current scan truth into the open design WITHOUT
    // destroying edits - matched resources take live name/location, live-only ones are
    // added, design-only nodes are kept and reported (never deleted here). Saved under the
    // current name through the ordinary save contract; only the undo history resets,
    // because the canvas is reloaded from the merged graph.
    private async Task MergePlaneAsync()
    {
        if (browseScanId is null || adoptBusy)
            return;
        var designName = adsContext.CurrentDesignName;
        if (string.IsNullOrEmpty(designName))
            return;
        var items = Filtered().ToList();
        if (items.Count == 0 || items.Count > AdoptLimit)
            return;
        if (!await Modal.ConfirmAsync(new ConfirmOptions
        {
            Title = "Merge live state into the design?",
            Content = $"'{designName}' is updated from this scan: matched resources take live names/locations and new resources are added. Nothing is moved or deleted; the undo history resets.",
            OkType = ButtonType.Primary,
            OkText = "Merge",
            CancelText = "Cancel",
        }))
            return;

        adoptBusy = true;
        try
        {
            var intent = await DataModelFactory.SaveDiagramToDto(adsContext.Diagram, mapper);
            var icons = BuildIconIndex();
            var merged = LivePlaneMerger.Merge(intent, items.Select(ToAdoptable),
                key => icons.GetValueOrDefault(key));
            var status = await designService.SaveDesign(designName, JsonSerializer.Serialize(merged.Graph));
            if (status != 200)
            {
                Message.Error("The merged design could not be saved; the canvas is unchanged.");
                return;
            }

            ReloadCanvas(merged.Graph);

            Message.Success($"Merged into '{designName}': {merged.Updated} confirmed, {merged.Added.Count} new"
                + (merged.MissingInLive.Count > 0 ? $", {merged.MissingInLive.Count} no longer in Azure (kept on the canvas)" : "")
                + ".");
            if (FeedbackRef as DrawerRef<string> is { } dr)
                await dr.CloseAsync(string.Empty);
        }
        finally
        {
            adoptBusy = false;
        }
    }

    // Reconcile verbs [58] for single rows: design-side edits only, saved through the ordinary
    // design contract - neither issues an Azure call; the live truth is the browsed scan snapshot.
    // The canvas reload resets undo (same contract as the plane merge); the drawer stays open so
    // the chips visibly follow the new truth.
    private async Task RefreshRowAsync(InventoryItem item)
    {
        var designName = adsContext.CurrentDesignName;
        if (string.IsNullOrEmpty(designName) || adoptBusy || browseScanId is null)
            return;
        adoptBusy = true;
        try
        {
            var intent = await DataModelFactory.SaveDiagramToDto(adsContext.Diagram, mapper);
            var (graph, changed) = ReconcileEngine.RefreshFromLive(intent, ToAdoptable(item));
            if (!changed)
            {
                await RecomputeReconcileAsync();
                return;
            }
            var status = await designService.SaveDesign(designName, JsonSerializer.Serialize(graph));
            if (status != 200)
            {
                Message.Error("The refreshed design could not be saved; the canvas is unchanged.");
                return;
            }
            ReloadCanvas(graph);
            await RecomputeReconcileAsync();
            Message.Success($"'{item.Name}' took its live name/location into '{designName}'.");
        }
        finally
        {
            adoptBusy = false;
        }
    }

    private async Task DetachDesignOnlyAsync(string id)
    {
        var designName = adsContext.CurrentDesignName;
        if (string.IsNullOrEmpty(designName) || adoptBusy || browseScanId is null)
            return;
        adoptBusy = true;
        try
        {
            var intent = await DataModelFactory.SaveDiagramToDto(adsContext.Diagram, mapper);
            var (graph, detached) = ReconcileEngine.Detach(intent, new[] { id });
            if (detached.Count == 0)
            {
                await RecomputeReconcileAsync();
                return;
            }
            var status = await designService.SaveDesign(designName, JsonSerializer.Serialize(graph));
            if (status != 200)
            {
                Message.Error("The detached design could not be saved; the canvas is unchanged.");
                return;
            }
            ReloadCanvas(graph);
            await RecomputeReconcileAsync();
            Message.Success($"Detached in '{designName}': the tile stays as intent, nothing in Azure was touched.");
        }
        finally
        {
            adoptBusy = false;
        }
    }

    private async Task LoadTopologyAsync()
    {
        topoChanged = null;
        if (topoScanId is null)
        {
            topoItems = [];
            return;
        }

        var rows = await Session.GetSnapshotsAsync(topoScanId);
        topoItems = rows.Select(ToItem).ToList();

        // rescan diff (8.4): changed or new ids versus the previous completed scan
        var prev = completed.FirstOrDefault(s => s.Id != topoScanId);
        if (prev is not null)
        {
            var prevRows = (await Session.GetSnapshotsAsync(prev.Id))
                .GroupBy(r => r.ResourceId, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
            var changed = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var r in rows)
            {
                if (!prevRows.TryGetValue(r.ResourceId, out var p) ||
                    p.PropertiesJson != r.PropertiesJson || p.TagsJson != r.TagsJson || p.Name != r.Name)
                {
                    changed.Add(r.ResourceId);
                }
            }

            topoChanged = changed;
        }

        // placements of resources missing from the newest scan are stale - forget them
        if (completed.FirstOrDefault()?.Id == topoScanId)
        {
            await Session.Positions.PruneAsync(rows.Select(r => r.ResourceId).ToList());
        }
    }

    private IEnumerable<InventoryItem> Filtered()
    {
        foreach (var item in browseItems)
        {
            if (browseProvider.Length > 0 && !item.Type.StartsWith(browseProvider + "/", StringComparison.OrdinalIgnoreCase)) continue;
            if (browseLocation.Length > 0 && !string.Equals(item.Location, browseLocation, StringComparison.OrdinalIgnoreCase)) continue;
            if (browseOwner is { Length: > 0 } owner &&
                (!item.Tags.TryGetValue("owner", out var o) || !string.Equals(o, owner, StringComparison.OrdinalIgnoreCase))) continue;
            if (browseSearch.Length > 0 &&
                !item.Name.Contains(browseSearch, StringComparison.OrdinalIgnoreCase) &&
                !item.Id.Contains(browseSearch, StringComparison.OrdinalIgnoreCase)) continue;
            if (unmanagedOnly && unmanagedAudit?.UnmanagedIds.Contains(item.Id) != true) continue;
            yield return item;
        }
    }

    private async Task LoadDecomAsync()
    {
        decomPlan = null;
        decomManifest = null;
        decomRunbook = null;
        decomWindowRow = null;
        decomExecRows = null;
        decomReleaseRows = null;
        decomExecError = null;
        decomReleaseError = null;
