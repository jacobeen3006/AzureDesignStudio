    private IEnumerable<InventoryItem> DecomFiltered() =>
        string.IsNullOrEmpty(decomSearch)
            ? decomItems
            : decomItems.Where(i => i.Name.Contains(decomSearch, StringComparison.OrdinalIgnoreCase)
                                 || i.Id.Contains(decomSearch, StringComparison.OrdinalIgnoreCase));

    private void ToggleDecom(string id, ChangeEventArgs e)
    {
        if (e.Value is true or "true") decomSelected.Add(id); else decomSelected.Remove(id);
    }

    private void RunDecomPreview()
    {
        if (decomSelected.Count == 0)
            return;
        decomManifest = null;
        decomPlan = DecommissionPlanner.Plan(decomItems, decomSelected.ToList());
    }

    // Confirmed set for [66]: everything selected that no refusal blocked. Manifest writing
    // stays a LOCAL file write - the plan is evidence-caveated, not a deploy approval.
    private IReadOnlyList<string> DecomConfirmed
    {
        get
        {
            if (decomPlan is null)
                return [];
            var refused = new HashSet<string>(
                decomPlan.Blockers.Where(b => b.Severity == DecommissionSeverity.Refusal).Select(b => b.ResourceId),
                StringComparer.OrdinalIgnoreCase);
            return decomPlan.Candidates.Where(c => !refused.Contains(c)).ToList();
        }
    }

    private async Task SaveManifestAsync()
    {
        var confirmed = DecomConfirmed;
        if (decomPlan is null || confirmed.Count == 0 || decomScanId is null)
            return;
        decomManifest = RetainBeforeRetire.Build(decomItems, confirmed, backupItems: null);
        var json = JsonSerializer.Serialize(decomManifest, new JsonSerializerOptions { WriteIndented = true });
        try
        {
            // MAUI 10 has no save-file picker; Downloads + open-with-default is the honest route,
            // and the manifest's whole point is to survive the teardown it documents.
            var dir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
            Directory.CreateDirectory(dir);
            var path = Path.Combine(dir, $"retention-manifest-{decomScanId}.json");
            await File.WriteAllTextAsync(path, json);
            try
            {
                await Launcher.OpenAsync(new OpenFileRequest("Retention manifest", new ReadOnlyFile(path)));
            }
            catch (Exception)
            {
                // No JSON handler - the file is still on disk where the message says it is.
            }
            Message.Success($"Retention manifest: {decomManifest.Rows.Count} row(s), "
                + $"{decomManifest.Caveats.Count} caveat(s) - written to {path}");
        }
        catch (Exception e)
        {
            Message.Error($"Could not write the manifest: {e.Message}");
        }
    }

    // [69][71] Runbook-as-code: the three review artifacts under one plan hash. Writing them
    // is local file IO, not execution - the purge scripts carry the T+N epoch guard and refuse
    // to touch ARM until the undo window closes. Abort lines live inside the same scripts.
    private async Task SaveRunbookAsync()
    {
        if (decomPlan is not { Allowed: true } || decomScanId is null)
            return;
        if (decomPurgeDays is < 1 or > 365)
        {
            Message.Error("Undo window must be 1-365 days - the plan hash depends on it.");
            return;
        }
        try
        {
            var rb = DecommissionRunbook.Generate(decomPlan, decomItems,
                new RunbookOptions(DateTimeOffset.UtcNow, TimeSpan.FromDays(decomPurgeDays)));
            decomRunbook = rb;
            await LoadDecomWindowRowAsync();
            // Folder named by scan + deterministic window id: re-running the same plan shape
            // lands on the same reviewed bytes, so the folder is the review record.
            var dir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads",
                $"decom-{decomScanId}-{rb.Window.WindowId}");
            Directory.CreateDirectory(dir);
            await File.WriteAllTextAsync(Path.Combine(dir, "runbook.md"), rb.Markdown());
            await File.WriteAllTextAsync(Path.Combine(dir, "purge.sh"), rb.CliScript());
            await File.WriteAllTextAsync(Path.Combine(dir, "purge.ps1"), rb.PowerShellScript());
            var md = Path.Combine(dir, "runbook.md");
            try
            {
                await Launcher.OpenAsync(new OpenFileRequest("Decommission runbook", new ReadOnlyFile(md)));
            }
            catch (Exception)
            {
                // No markdown handler - the files are still on disk where the message says they are.
            }
            Message.Success($"Runbook {rb.PlanHash} - runbook.md + purge.sh + purge.ps1 in {dir}; "
                + $"purge refuses to run until {rb.PurgeNotBefore.ToUniversalTime():O}");
        }
        catch (Exception e)
        {
            // The planner is the oracle: an allowed plan never throws here, but a refusal that
            // raced a re-plan must not take the drawer down.
            Message.Error($"Could not render the runbook: {e.Message}");
        }
    }

    // v2 13.5 window execution: the runbook's Stage 0 lines are the lock scopes (one per
    // protected resource); the execution hash binds exactly that set (DecomExecution
    // canonical), so the server re-verifies the caller against the approved hash.
    private static IReadOnlyList<string> WindowScopes(Runbook rb) =>
        rb.Stages.Count > 0 ? rb.Stages[0].Lines.Select(l => l.ResourceId).ToList() : [];

    // The window's subscription is embedded in every scope (/subscriptions/{id}/...); a
    // multi-subscription scan yields the first scope's subscription for the hash's sub field.
    private static string SubscriptionOf(IReadOnlyList<string> scopes)
    {
        foreach (var scope in scopes)
        {
            var s = scope.TrimStart('/');
            if (s.StartsWith("subscriptions/", StringComparison.OrdinalIgnoreCase))
            {
                var rest = s["subscriptions/".Length..];
                var slash = rest.IndexOf('/');
                if (slash > 0)
                    return rest[..slash];
                if (rest.Length > 0)
                    return rest;
            }
        }
        return "";
    }

    // On tab open / runbook save: the workspace row for this subscription + window id (or,
    // with no runbook open, the most recent one) - it gates the release verb and the banner.
    private async Task LoadDecomWindowRowAsync()
    {
        if (decomRunbook is { } rb)
        {
            decomWindowRow = await decomWindows.GetAsync(SubscriptionOf(WindowScopes(rb)), rb.Window.WindowId);
            return;
        }
        decomWindowRow = await decomWindows.LatestAsync();
    }

    // [13.5] Approve (naming the execution hash) then land: the server re-verifies the hash
    // and lands can-not-delete locks only - nothing is deleted here, purge stays script-side.
    private async Task ApproveAndExecuteAsync()
    {
        if (decomRunbook is not { } rb || decomPlan is not { Allowed: true } || decomExecBusy || ArmUnavailable)
            return;
        var windowId = rb.Window.WindowId;
        var scopes = WindowScopes(rb);
        var subscriptionId = SubscriptionOf(scopes);
        var executionHash = DecomExecution.ExecutionHash(windowId, rb.PlanHash, subscriptionId, rb.PurgeNotBefore,
            scopes.OrderBy(s => s.ToLowerInvariant(), StringComparer.Ordinal));

        if (!await Modal.ConfirmAsync(new ConfirmOptions
        {
            Title = "Approve & land the window locks?",
            Content = $"""
                {scopes.Count} scope(s)
                plan {rb.PlanHash}
                execution {executionHash}
                purge not before {rb.PurgeNotBefore.LocalDateTime:dd.MM HH:mm}
                The app lands can-not-delete locks only - it never deletes anything; purge stays script-side.
                """,
            OkType = ButtonType.Primary,
            OkText = "Approve & land",
            CancelText = "Cancel",
        }))
            return;

        decomExecBusy = true;
        decomExecError = null;
        decomExecRows = null;
        try
        {
            var approval = await DeployClient.ApproveDecomWindowAsync(new ApproveDecomWindowRequest
            {
                SubscriptionId = subscriptionId,
                WindowId = windowId,
                PlanHash = rb.PlanHash,
                ExecutionHash = executionHash,
            });
            if (approval.StatusCode != 200)
            {
                // Refusal (403/409/412): surface verbatim, do not execute.
                decomExecError = approval.ErrorMessage.Length > 0
                    ? approval.ErrorMessage
                    : $"approval refused (HTTP {approval.StatusCode})";
                return;
            }

            var exec = await DeployClient.ExecuteDecomWindowAsync(new ExecuteDecomWindowRequest
            {
                SubscriptionId = subscriptionId,
                ScanId = decomScanId ?? "",
                WindowId = windowId,
                PlanHash = rb.PlanHash,
                ExecutionHash = executionHash,
                // "O" round-trip: the server rebuilds the window notes from these bytes.
                WindowStartUtc = rb.Window.Start.ToUniversalTime().ToString("O"),
                WindowEndUtc = rb.Window.End.ToUniversalTime().ToString("O"),
                PurgeNotBeforeUtc = rb.PurgeNotBefore.ToUniversalTime().ToString("O"),
                Scopes = { scopes.OrderBy(s => s.ToLowerInvariant(), StringComparer.Ordinal) },
            });

            if (exec.StatusCode != 200)
            {
                decomExecError = exec.ErrorMessage.Length > 0
                    ? exec.ErrorMessage
                    : $"execution refused (HTTP {exec.StatusCode})";
                await PersistDecomWindowAsync(rb, subscriptionId, executionHash, "failed", []);
                return;
            }

            decomExecRows = exec.Rows.ToList();
            var notLocked = decomExecRows.Count(r => r.Outcome is not ("locked" or "already-locked"));
            var state = notLocked == 0 ? "executed" : "partial";
            await PersistDecomWindowAsync(rb, subscriptionId, executionHash, state, decomExecRows);
            Message.Success($"Window {windowId}: {decomExecRows.Count(r => r.Outcome == "locked")} locked, "
                + $"{decomExecRows.Count(r => r.Outcome == "already-locked")} already-locked, {notLocked} not locked "
                + $"({state}); apply {exec.ApplyId}");
        }
        catch (Exception e)
        {
            Message.Error($"Window execution failed: {e.Message}");
        }
        finally
        {
            decomExecBusy = false;
        }
    }

    // [13.5] Release: re-sends the STORED scopes (selection drift-proof) - the server removes
    // only the window's own locks by name; foreign locks survive.
    private async Task ReleaseWindowAsync()
    {
        if (decomWindowRow is not { } row || decomReleaseBusy || ArmUnavailable)
            return;
        decomReleaseBusy = true;
        decomReleaseError = null;
        decomReleaseRows = null;
        try
        {
            var scopes = JsonSerializer.Deserialize<List<string>>(row.ScopesJson) ?? [];
            var resp = await DeployClient.ReleaseDecomWindowAsync(new ReleaseDecomWindowRequest
            {
                SubscriptionId = row.SubscriptionId,
                WindowId = row.WindowId,
                Scopes = { scopes },
            });

            if (resp.StatusCode != 200)
            {
                decomReleaseError = resp.ErrorMessage.Length > 0
                    ? resp.ErrorMessage
                    : $"release refused (HTTP {resp.StatusCode})";
                return;
            }

            decomReleaseRows = resp.Rows.ToList();
            row.State = "released";
            row.RowsJson = JsonSerializer.Serialize(decomReleaseRows);
            row.UpdatedAtUtc = DateTimeOffset.UtcNow;
            await decomWindows.UpsertAsync(row);
            var removed = decomReleaseRows.Count(r => r.Outcome == "released");
            Message.Success($"Window {row.WindowId} released: {removed} lock(s) removed, "
                + $"{decomReleaseRows.Count - removed} left in place or failed");
        }
        catch (Exception e)
        {
            Message.Error($"Window release failed: {e.Message}");
        }
        finally
        {
            decomReleaseBusy = false;
        }
    }

    private async Task PersistDecomWindowAsync(Runbook rb, string subscriptionId, string executionHash,
        string state, IReadOnlyList<DecomLockRow> rows)
    {
        var scopes = WindowScopes(rb);
        var row = new DecomWindowModel
        {
            WindowId = rb.Window.WindowId,
            ScanId = decomScanId ?? "",
            SubscriptionId = subscriptionId,
            PlanHash = rb.PlanHash,
            ExecutionHash = executionHash,
            ScopesJson = JsonSerializer.Serialize(scopes),
            State = state,
            RowsJson = rows.Count > 0 ? JsonSerializer.Serialize(rows) : null,
            UpdatedAtUtc = DateTimeOffset.UtcNow,
        };
        await decomWindows.UpsertAsync(row);
        decomWindowRow = row;
    }

    // 9.6: a monthly governance report assembled from the same offline engines the tabs
    // render - findings, retirement watch, exposure, unmanaged audit, drift since the scan.
    // Every section names its source; the header names the scan, freshness and whether
    // protection was judged. No spend section: those figures are live-only on demand.
    private async Task SaveReportAsync()
    {
        if (reportScan is not { } scan)
            return;
        var (_, exposure, audit, driftList, policyNote, driftError) = await CollectReportSectionsAsync(scan);
        var drift = driftList ?? [];
        var scanSince = scan.FinishedAt ?? scan.StartedAt;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("# Azure Design Studio - governance report");
        sb.AppendLine();
        sb.AppendLine($"scan {scan.Id} · scope {scan.Scope} · {reportItems.Count} resources · taken {scanSince.UtcDateTime:yyyy-MM-dd HH:mm} UTC");
        sb.AppendLine($"retirement data as of {catalog.DataAsOf:yyyy-MM-dd} ({catalog.FreshnessAt(DateTimeOffset.UtcNow)}); {policyNote}");
        sb.AppendLine();
        sb.AppendLine($"## Findings ({reportFindings.Count})");
        foreach (var f in reportFindings)
            sb.AppendLine($"- [{f.Kind}] {f.ResourceId} ({f.ResourceType}): {f.Detail}");
        if (reportFindings.Count == 0) sb.AppendLine("- none");
        sb.AppendLine();
        sb.AppendLine($"## Retirement watch ({watched.Count})");
        foreach (var (item, entry) in watched)
            sb.AppendLine($"- [{entry.Status}] {item.Id} ({item.Type}): {entry.Note}");
        if (watched.Count == 0) sb.AppendLine("- none");
        sb.AppendLine();
        sb.AppendLine($"## Internet exposure ({exposure.Count})");
        foreach (var f in exposure)
            sb.AppendLine($"- [{f.Severity}] {f.ResourceId} ({f.ResourceType}) {f.Kind}: {f.Detail} -> {f.Remediation}");
        if (exposure.Count == 0) sb.AppendLine("- none");
        foreach (var cav in AdsToolEngine.ExposureCaveats) sb.AppendLine($"  caveat: {cav}");
        sb.AppendLine();
        sb.AppendLine($"## Unmanaged ({audit.Unmanaged.Count}) / protected ({audit.ProtectedResources.Count})");
        foreach (var f in audit.Unmanaged) sb.AppendLine($"- {f.Id} ({f.Type}): {f.Reason}");
        if (audit.Unmanaged.Count == 0) sb.AppendLine("- none");
        foreach (var cav in AdsToolEngine.UnmanagedCaveats) sb.AppendLine($"  caveat: {cav}");
        sb.AppendLine();
        sb.AppendLine($"## Changes since the scan ({drift.Count})");
        foreach (var d in drift)
            sb.AppendLine($"- [{d.Status}] {d.ResourceId}: {d.ChangedAt.UtcDateTime:yyyy-MM-dd HH:mm} UTC by {(string.IsNullOrEmpty(d.ChangedBy) ? "unknown actor" : d.ChangedBy)}");
        if (drift.Count == 0) sb.AppendLine(driftError is null ? "- none recorded" : $"- not evaluated: {driftError}");
        sb.AppendLine();
        sb.AppendLine("Spend figures are not part of this snapshot report - the drawer's Cost tab queries Cost Management on demand and prints source, window, currency and as-of with its numbers.");

        try
        {
            var dir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
            Directory.CreateDirectory(dir);
            var path = Path.Combine(dir, $"ads-report-{SafeScanId(scan.Id)}.md");
            await File.WriteAllTextAsync(path, sb.ToString());
            try
            {
                await Launcher.OpenAsync(new OpenFileRequest("Governance report", new ReadOnlyFile(path)));
            }
            catch (Exception)
            {
                // No markdown handler - the file is still on disk where the message says it is.
            }
            Message.Success($"Governance report written to {path}");
        }
        catch (Exception e) { Message.Error($"Could not write the report: {e.Message}"); }
    }

    // v2 9.6: the Markdown report and the bundle share one collector - same sources, same
    // fail-soft notes - so the two artifacts can never disagree about what was measured.
    private async Task<(IReadOnlyList<InventoryItem> Items, IReadOnlyList<ExposureFinding> Exposure,
        ManagementAudit Audit, IReadOnlyList<LiveDriftItem>? Drift, string PolicyNote, string? DriftError)>
        CollectReportSectionsAsync(ScanRecord scan)
    {
        var items = reportItems;
        var exposure = ExposureAnalyzer.Analyze(items);
        var policy = GuardrailPolicy.Empty;
        var policyNote = "guardrail policy not loaded - protection not judged";
        if (!ArmUnavailable)
        {
            try
            {
                var response = await DeployClient.GetGuardrailPolicyAsync(new EmptyMessage());
                if (response.StatusCode == 0 && response.Json.Length > 0)
                {
                    policy = GuardrailPolicy.FromJson(response.Json);
                    policyNote = "guardrail policy: server copy";
                }
            }
            catch (Exception) { /* the empty-policy note above stands */ }
        }
        var audit = UnmanagedDetector.Audit(items, policy);
        var scanSince = scan.FinishedAt ?? scan.StartedAt;
        IReadOnlyList<LiveDriftItem>? drift = null;
        string? driftError = null;
        try { drift = await Feed.DriftSinceScanAsync(scan.Id, scanSince); }
        catch (Exception e) { driftError = e.Message; }
        return (items, exposure, audit, drift, policyNote, driftError);
    }

    // v2 9.6 closer: the same governance payload as report.html + report.json +
    // controls-audit.csv (ReportBundle.Build, deterministic, no clocks inside). Spend rides
    // along only when the Cost tab actually fetched figures; sections the run did not
    // produce stay absent - the bundle never lies with empty tables.
    private async Task SaveReportBundleAsync()
    {
        if (reportScan is not { } scan)
            return;
        try
        {
            var (items, exposure, audit, driftList, _, _) = await CollectReportSectionsAsync(scan);
            IReadOnlyList<SpendBucket>? spendBuckets = null;
            SpendProvenance? spendProvenance = null;
            var spendOk = costResults.Where(c => c.Result is not null).ToList();
            if (spendOk.Count > 0)
            {
                var rows = spendOk.SelectMany(c => c.Result!.Rows).ToList();
                spendBuckets = CostRollup.By(rows, SpendDimension.ServiceFamily);
                // One window/currency per scan run in practice; name every sub the rows came from.
                spendProvenance = spendOk[0].Result!.Provenance with { Scope = string.Join(", ", spendOk.Select(c => c.Sub)) };
            }
            var model = new ReportModel(
                Title: "Azure Design Studio governance report",
                Scope: scan.Scope,
                AsOf: DateTimeOffset.UtcNow,
                Exposure: exposure,
                Unmanaged: audit,
                Drift: driftList,
                SpendByServiceFamily: spendBuckets,
                SpendProvenance: spendProvenance,
                TopologySvg: TopologySvgWriter.Render(items));
            var files = ReportBundle.Build(model);
            var dir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads",
                $"ads-report-{SafeScanId(scan.Id)}");
            Directory.CreateDirectory(dir);
            foreach (var (name, content) in files)
                await File.WriteAllTextAsync(Path.Combine(dir, name), content);
            try
            {
                await Launcher.OpenAsync(new OpenFileRequest("Governance report bundle",
                    new ReadOnlyFile(Path.Combine(dir, ReportBundle.HtmlFile))));
            }
            catch (Exception)
            {
                // No html handler - the files are still on disk where the message says they are.
            }
            Message.Success($"Report bundle (HTML + JSON + CSV) written to {dir}");
        }
        catch (Exception e) { Message.Error($"Could not render the report bundle: {e.Message}"); }
    }

    // [77] Chargeback digest: the queried spend joined to the scan's own owner tags. Same
    // fetched figures the table shows - no new Azure call; the workspace snapshot carries tags.
    private async Task SaveChargebackAsync()
    {
        if (costScanId is null)
            return;
        var ok = costResults.Where(c => c.Result is not null).ToList();
        if (ok.Count == 0)
            return;
        try
        {
            var items = (await Session.GetSnapshotsAsync(costScanId)).Select(ToItem).ToList();
            var rows = ok.SelectMany(c => c.Result!.Rows).ToList();
            var piles = ChargebackDigest.Build(rows, items);
            var provenance = ok[0].Result!.Provenance with { Scope = string.Join(", ", ok.Select(c => c.Sub)) };
            var dir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads",
                $"ads-chargeback-{SafeScanId(costScanId)}");
            Directory.CreateDirectory(dir);
            var path = Path.Combine(dir, "chargeback.csv");
            await File.WriteAllTextAsync(path, ChargebackDigest.Csv(piles, provenance));
            var left = piles.Where(p => p.Owner is ChargebackDigest.UntaggedOwner or ChargebackDigest.UnmatchedOwner).ToList();
            var honest = left.Count == 0 ? "every pile carries an owner tag"
                : "leftover piles: " + string.Join(", ", left.Select(p => $"{p.Owner} {p.Currency} {p.Cost:0.00} ({p.Share:P0})"));
            Message.Success($"Chargeback digest written to {path} - {honest}");
        }
        catch (Exception e) { Message.Error($"Could not write the chargeback digest: {e.Message}"); }
    }

    // [32] Bill of materials: canonical tenant-state document for git evidence. No clock inside,
    // so the only bytes that ever move in a PR diff are real state changes.
    private async Task SaveBomAsync()
    {
        if (browseScanId is null)
            return;
        try
        {
            var scope = completed.FirstOrDefault(s => s.Id == browseScanId)?.Scope ?? browseScanId;
            var bom = BillOfMaterials.Render(browseItems, scope);
            var hash = JsonDocument.Parse(bom).RootElement.GetProperty("contentHash").GetString();
            var path = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads",
                $"ads-bom-{SafeScanId(browseScanId)}.json");
            await File.WriteAllTextAsync(path, bom);
            Message.Success($"Bill of materials written to {path} - {browseItems.Count} resources, {hash}; identical tenant state always renders identical bytes");
        }
        catch (Exception e) { Message.Error($"Could not write the bill of materials: {e.Message}"); }
    }

    // Scan ids are GUIDs but not guaranteed - keep any shape intact, only neutralise path-unsafe chars.
    private static string SafeScanId(string scanId) =>
        string.Concat(scanId.Select(c => char.IsAsciiLetterOrDigit(c) || c is '-' or '_' ? c : '-'));

    private static string ExposureColor(ExposureSeverity s) => s switch
    {
        ExposureSeverity.Critical => "red",
        ExposureSeverity.High => "orange",
        ExposureSeverity.Medium => "gold",
        _ => "blue",
    };

    private static string DriftColor(LiveDriftStatus s) => s switch
    {
        LiveDriftStatus.New => "green",
        LiveDriftStatus.Deleted => "red",
        _ => "blue",
    };

    private static string LockOutcomeColor(string outcome) => outcome switch
    {
        "locked" => "green",
        "released" => "green",
        "already-locked" => "blue",
        "left-in-place" => "orange",
        "foreign-locked" => "orange",
        _ => "red",
    };

    private static string SeverityColor(DecommissionSeverity s) => s switch
    {
        DecommissionSeverity.Refusal => "red",
        DecommissionSeverity.Warning => "orange",
        DecommissionSeverity.Info => "blue",
        _ => "default",
    };

    private static InventoryItem ToItem(ResourceSnapshotRecord r) => new(
        r.ResourceId, r.Name, r.ResourceType, r.Location ?? "", r.ResourceGroup ?? "", r.SubscriptionId ?? "",
        ParseTags(r.TagsJson), ParseRaw(r.PropertiesJson));

    private static IReadOnlyDictionary<string, string> ParseTags(string? json) =>
        json is null ? new Dictionary<string, string>()
                     : JsonSerializer.Deserialize<Dictionary<string, string>>(json) ?? new Dictionary<string, string>();

    private static JsonElement? ParseRaw(string? json)
    {
        if (json is null) return null;
        try { return JsonDocument.Parse(json).RootElement.Clone(); }
        catch (JsonException) { return null; }
    }

    private static string Pretty(InventoryItem item) => item.Raw is { } raw
        ? JsonSerializer.Serialize(raw, new JsonSerializerOptions { WriteIndented = true })
        : "{}";

    private static string NameOf(string id) => id.Contains('/') ? id[(id.LastIndexOf('/') + 1)..] : id;

    private static string ProbeColor(ProbeStatus s) => s switch
    {
        ProbeStatus.Available => "green",
        ProbeStatus.AvailableWithCaveat => "orange",
        _ => "red",
    };

    private static string ScanColor(string status) => status switch
    {
        "Completed" => "green",
        "Running" => "blue",
        "Canceled" => "orange",
        _ => "red",
    };

    private static string FreshnessColor(CatalogFreshness f) => f switch
    {
        CatalogFreshness.Current => "green",
        CatalogFreshness.ReviewDue => "orange",
        _ => "red",
    };
    private static string KindColor(FindingKind kind) => kind switch
    {
        FindingKind.BrokenReference => "red",
        FindingKind.Orphan => "orange",
        _ => "blue",
    };

    public new void Dispose()
    {
        Session.StateChanged -= OnSessionChanged;
        base.Dispose();
    }
