    // 10.2 export: the scan's inventory becomes a reviewable Terraform starting point -
    // one azapi_resource per resource with the recorded live properties; the attribute
    // table (AzureApiVersions) pins per-type api-versions, unknown types keep the fallback.
    private async Task SaveTerraformAsync()
    {
        var scanId = browseScanId;
        if (scanId is null || browseItems.Count == 0)
            return;
        try
        {
            var tf = TerraformText.Generate(browseItems, typeApiVersions: AzureApiVersions.Map);
            var dir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
            Directory.CreateDirectory(dir);
            // Scan ids are GUIDs but not guaranteed - keep any shape intact, only neutralise path-unsafe chars.
            var safeId = string.Concat(scanId.Select(c => char.IsAsciiLetterOrDigit(c) || c is '-' or '_' ? c : '-'));
            var path = Path.Combine(dir, $"ads-tf-{safeId}.tf");
            await File.WriteAllTextAsync(path, tf);
            try
            {
                await Launcher.OpenAsync(new OpenFileRequest("Terraform export", new ReadOnlyFile(path)));
            }
            catch (Exception)
            {
                // No .tf handler - the file is still on disk where the message says it is.
            }
            Message.Success($"Terraform export written to {path}");
        }
        catch (Exception e) { Message.Error($"Could not write the Terraform export: {e.Message}"); }
    }

    // 9.3 overlay on the browse rows: unmanaged = no orchestration marker; protection is
    // judged only by the server's guardrail policy - offline the note says it was not judged.
    private async Task RecomputeUnmanagedAsync()
    {
        var policy = GuardrailPolicy.Empty;
        unmanagedPolicyNote = "guardrail policy not loaded - protection not judged";
        protectedIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (!ArmUnavailable)
        {
            try
            {
                var response = await DeployClient.GetGuardrailPolicyAsync(new EmptyMessage());
                if (response.StatusCode == 0 && response.Json.Length > 0)
                {
                    policy = GuardrailPolicy.FromJson(response.Json);
                    unmanagedPolicyNote = "guardrail policy: server copy";
                }
            }
            catch (Exception) { /* offline: the empty-policy note above stands */ }
        }
        unmanagedAudit = UnmanagedDetector.Audit(browseItems, policy);
        protectedIds = unmanagedAudit.ProtectedResources
            .Select(f => f.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

