@inherits FeedbackComponent<string, string>
@using Grpc.Net.ClientFactory
@using AzureDesignStudio.SharedModels.Protos
@using System.Text.Json
@using AntDesign
@using AzureDesignStudio.Discovery.Analysis
@using EmptyMessage = Google.Protobuf.WellKnownTypes.Empty
@using AzureDesignStudio.Discovery.Arm
@using AzureDesignStudio.Discovery.ResourceGraph
@using AzureDesignStudio.Discovery.Inventory
@using AzureDesignStudio.Discovery.Decommission
@using AzureDesignStudio.Discovery.Preflight
@using AzureDesignStudio.Discovery.Exposure
@using AzureDesignStudio.Discovery.Drift
@using AzureDesignStudio.Discovery.Cost
@using AzureDesignStudio.Discovery.Unmanaged
@using AzureDesignStudio.Discovery.Mcp
@using AzureDesignStudio.Discovery.Report
@using AzureDesignStudio.Discovery.Iac
@using SubscriptionInfo = AzureDesignStudio.Discovery.Arm.SubscriptionInfo
@using AzureDesignStudio.Workspace
@implements IDisposable
@inject TenantScanSession Session
@using AzureDesignStudio.Core
@using AzureDesignStudio.Core.DTO
@using AzureDesignStudio.Core.Common
@using AzureDesignStudio.Services
@using AutoMapper
@inject DesignGrpcService designService
@inject AdsContext adsContext
@inject IMapper mapper
@inject GrpcClientFactory grpcFactory
@inject WorkspaceDecomWindows decomWindows
@inject ChangeFeedService Feed
@inject ActualSpendClient Spend
@inject DeploymentStackClient Stacks
@inject MessageService Message
@inject ModalService Modal

@* Tenant discovery drawer (plan 7.8): scan a tenant, browse the snapshot with facets,
   read the orphan/retirement report. Desktop-only; opened through AdsHostFeatures. *@

<div style="padding:0 4px;">
    <div style="display:flex;gap:8px;margin-bottom:12px;">
        @foreach (var (key, label) in new[] { ("scan", "Scan"), ("browse", "Inventory"), ("topology", "Topology"), ("exposure", "Exposure"), ("reach", "Reach"), ("changes", "Changes"), ("cost", "Cost"), ("stacks", "Stacks"), ("decom", "Decommission"), ("report", "Report") })
        {
            <Button Type="@(activeTab == key ? ButtonType.Primary : ButtonType.Default)"
                    Size="ButtonSize.Small" OnClick="@(() => SwitchTabAsync(key))">@label</Button>
        }
    </div>

    @if (activeTab == "scan")
    {
        @if (loading)
        {
            <span>Loading subscriptions…</span>
        }
        else if (subscriptions.Count == 0)
        {
            <span>No subscriptions visible to this account. @loadError</span>
        }
        else
        {
            <div style="max-height:220px;overflow:auto;border:1px solid #f0f0f0;padding:8px;">
                <div style="margin-bottom:4px;">
                    <label><input type="checkbox" checked="@(selected.Count == enabledCount)"
                                  @onchange="ToggleAll" /> <b>all (@enabledCount enabled)</b></label>
                </div>
                @foreach (var sub in subscriptions)
                {
                    <div>
                        <label>
                            <input type="checkbox" checked="@selected.Contains(sub.SubscriptionId)"
                                   @onchange="@(e => Toggle(sub.SubscriptionId, e))" />
                            @sub.DisplayName <span style="color:#999">(@sub.SubscriptionId[..8])</span>
                            @if (!string.Equals(sub.State, "Enabled", StringComparison.OrdinalIgnoreCase))
                            {
                                <span style="color:#999">[@sub.State]</span>
                            }
                        </label>
                    </div>
                }
            </div>

            <div style="display:flex;gap:8px;margin:12px 0;align-items:center;flex-wrap:wrap;">
                @if (!Session.Running)
                {
                    <Button Type="ButtonType.Primary" Size="ButtonSize.Small"
                            Disabled="@(selected.Count == 0)"
                            OnClick="StartAsync">Start scan (@selected.Count)</Button>
                    <Button Size="ButtonSize.Small" Disabled="@(selected.Count == 0)"
                            OnClick="PreflightAsync">Preflight</Button>
                    @if (resumable is not null)
                    {
                        <Button Size="ButtonSize.Small" OnClick="ResumeScanAsync">
                            Resume interrupted scan (@resumable.ResourceCount rows saved)
                        </Button>
                    }
                }
                else
                {
                    <Button Size="ButtonSize.Small" OnClick="@(_ => Session.PauseAsync())" Disabled="@Session.Paused">Pause</Button>
                    <Button Size="ButtonSize.Small" OnClick="@(_ => Session.ResumeRun())" Disabled="@(!Session.Paused)">Resume</Button>
                    <Button Danger Size="ButtonSize.Small" OnClick="@(_ => Session.Cancel())">Cancel</Button>
                }
            </div>

            @if (Session.Running)
            {
                <Progress Percent="@(Session.Progress is { QueriesTotal: > 0 } pr ? pr.QueriesCompleted * 100 / pr.QueriesTotal : 0)" />
                <span>@(Session.Progress?.QueriesCompleted ?? 0)/@(Session.Progress?.QueriesTotal ?? 0) query groups · @(Session.Progress?.Rows ?? 0) rows</span>
            }

            @if (Session.LastError is { } err)
            {
                <div style="color:#cf1322;margin-top:8px;">@err</div>
            }

            @if (probes is { Count: > 0 })
            {
                <h4 style="margin-top:12px;">Permissions</h4>
                <table style="width:100%;font-size:13px;">
                    @foreach (var probe in probes)
                    {
                        <tr>
                            <td><b>@probe.DisplayName</b><br /><span style="color:#999">@probe.RequiredRole</span></td>
                            <td><Tag Color="@ProbeColor(probe.Status)">@probe.Status</Tag></td>
                            <td>@probe.Detail</td>
                        </tr>
                    }
                </table>
            }

            <h4 style="margin-top:12px;">History</h4>
            @foreach (var scan in history)
            {
                <div style="display:flex;gap:8px;font-size:13px;border-bottom:1px solid #fafafa;padding:4px 0;">
                    <Tag Color="@ScanColor(scan.Status)">@scan.Status</Tag>
                    <span>@scan.Scope · @scan.ResourceCount rows</span>
                    <span style="color:#999">@(scan.StartedAt.LocalDateTime.ToString("dd.MM HH:mm"))</span>
                    @if (scan.Error is { } e)
                    {
                        <span style="color:#cf1322;">@e</span>
                    }
                </div>
            }
        }
    }
    else if (activeTab == "browse")
    {
        @if (browseScanId is null)
        {
            <div style="margin-bottom:8px;">
                @if (completed.Count == 0)
                {
                    <span>No completed scans yet.</span>
                }
                else
                {
                    <select value="@(browseScanId ?? "")" @onchange="OnBrowseScanPickedAsync">
                        <option value="">select a scan…</option>
                        @foreach (var scan in completed)
                        {
                            <option value="@scan.Id">@(scan.StartedAt.LocalDateTime.ToString("dd.MM HH:mm")) · @scan.Scope · @scan.ResourceCount rows</option>
                        }
                    </select>
                }
                <Tooltip Title="select a scan to export its inventory as Terraform">
                    <Button Size="ButtonSize.Small" Disabled="@true">Save Terraform (.tf)</Button>
                </Tooltip>
            </div>
        }
        else
        {
            <div style="display:flex;gap:8px;margin-bottom:8px;align-items:center;">
                <input style="flex:1;padding:4px;" placeholder="search name / id" @bind="browseSearch" @bind:event="oninput" />
                <select @bind="browseProvider">
                    <option value="">all providers</option>
                    @foreach (var facet in facets?.Providers ?? [])
                    {
                        <option value="@facet.Value">@facet.Value (@facet.Count)</option>
                    }
                </select>
                <select @bind="browseLocation">
                    <option value="">all locations</option>
                    @foreach (var facet in facets?.Locations ?? [])
                    {
                        <option value="@facet.Value">@facet.Value (@facet.Count)</option>
                    }
                </select>
                <a @onclick="@(() => browseScanId = null)">back</a>
                <Button Type="ButtonType.Primary" Size="ButtonSize.Small"
                        Disabled="@(adoptBusy || FilteredCount == 0 || FilteredCount > AdoptLimit)"
                        OnClick="AdoptAsync">@(adoptBusy ? "Adopting…" : $"Adopt {FilteredCount} as design")</Button>
                @if (!string.IsNullOrEmpty(adsContext.CurrentDesignName))
                {
                    <Button Size="ButtonSize.Small"
                            Disabled="@(adoptBusy || FilteredCount == 0 || FilteredCount > AdoptLimit)"
                            OnClick="MergePlaneAsync">@(adoptBusy ? "Merging…" : "Refresh live plane")</Button>
                }
                @if (reconcile is not null && NewInFilteredCount > 0)
                {
                    <Button Size="ButtonSize.Small"
                            Disabled="@adoptBusy"
                            OnClick="AddNewToDesignAsync">@(adoptBusy ? "Adding…" : $"+ Add {NewInFilteredCount} new to design")</Button>
                }
                @if (FilteredCount > AdoptLimit)
                {
                    <span style="color:#faad14;font-size:12px;">too many to open on the canvas - narrow below @AdoptLimit</span>
                }
                <Tooltip Title="@(browseItems.Count == 0 ? "no resources in this scan to export"
                                : "Export the scan's inventory as a Terraform .tf - one azapi_resource per resource, written to Downloads")">
                    <Button Size="ButtonSize.Small" Disabled="@(browseItems.Count == 0)"
                            OnClick="SaveTerraformAsync">Save Terraform (.tf)</Button>
                </Tooltip>
                <Tooltip Title="@(browseItems.Count == 0 ? "no resources in this scan to export"
                                : "The whole inventory as one deterministic JSON document with a sha256 content hash - commit it to git; identical tenant state renders identical bytes")">
                    <Button Size="ButtonSize.Small" Disabled="@(browseItems.Count == 0)"
                            OnClick="SaveBomAsync">Save bill of materials (JSON)</Button>
                </Tooltip>
            </div>

            @if (facets is { } f)
            {
                <div style="margin-bottom:8px;font-size:13px;color:#666;">
                    @f.Total resources · @f.Untagged untagged
                    @if (f.Owners.Count > 0)
                    {
                        <span> · owners: </span>
                        @foreach (var o in f.Owners)
                        {
                            <a style="margin-right:8px;" @onclick="@(() => browseOwner = o.Value)">@o.Value (@o.Count)</a>
                        }
                        <a @onclick="@(() => browseOwner = null)">clear</a>
                    }
                    @if (unmanagedAudit is { } au)
                    {
                        <span> · <a @onclick="@(() => unmanagedOnly = !unmanagedOnly)">@(unmanagedOnly ? "showing unmanaged only (clear)" : $"{au.Unmanaged.Count} unmanaged")</a> · @au.ProtectedResources.Count protected · <span style="color:#999">@unmanagedPolicyNote</span></span>
                    }
                </div>
            }

            @if (reconcile is { } rec)
            {
                <div style="display:flex;gap:6px;align-items:center;margin-bottom:8px;font-size:12px;color:#666;">
                    <span>vs '@adsContext.CurrentDesignName':</span>
                    <Tag Color="@("green")">@(rec.CountIn(DesignState.InBothSynced)) in design</Tag>
                    <Tag Color="@("orange")">@(rec.CountIn(DesignState.Drifted)) drift</Tag>
                    <Tag Color="@("red")">@(rec.CountIn(DesignState.InLiveNotDesign)) new</Tag>
                    <span>@rec.DesignOnly.Count design-only</span>
                    @if (rec.UntrackedDesignNodes > 0)
                    {
                        <span>@rec.UntrackedDesignNodes untracked</span>
                    }
                </div>
                @if (rec.CountIn(DesignState.Drifted) > 0)
                {
                    <div style="margin-bottom:8px;font-size:12px;color:#faad14;">drift = the canvas still says an old name/location; <i>refresh</i> a row to take its live truth, or run "Refresh live plane" for every row at once</div>
                }
                @if (rec.DesignOnly.Count > 0)
                {
                    <div style="margin-bottom:8px;font-size:12px;color:#999;">
                        on the canvas but not in this scan — kept; deploy is the gated path, <i>detach</i> drops only the live link:
                        @foreach (var id in rec.DesignOnly.Take(8))
                        {
                            <span style="margin-right:10px;white-space:nowrap;">
                                @id.Split('/')[^1]<Button Size="ButtonSize.Small" Type="@ButtonType.Link" Disabled="@adoptBusy"
                                                          @onclick="@(() => DetachDesignOnlyAsync(id))">detach</Button>
                            </span>
                        }
                        @if (rec.DesignOnly.Count > 8)
                        {
                            <span>… @rec.DesignOnly.Count total</span>
                        }
                    </div>
                }
            }
            @foreach (var item in Filtered().Take(200))
            {
                <div style="border-bottom:1px solid #fafafa;padding:4px 0;cursor:pointer;"
                     @onclick="@(() => expandedId = expandedId == item.Id ? null : item.Id)">
                    <b>@item.Name</b> <Tag>@item.ResourceTypeSegment</Tag>
                    <span style="color:#999;font-size:12px;">@item.Location · @item.ResourceGroup</span>
                    @if (StateOf(item) is { } st)
                    {
                        @if (st == DesignState.InLiveNotDesign)
                        {
                            <Tag Color="@("red")">new</Tag>
                        }
                        else if (st == DesignState.Drifted)
                        {
                            <Tag Color="@("orange")">drift</Tag>
                            <span @onclick:stopPropagation="true">
                                <Button Size="ButtonSize.Small" Type="@ButtonType.Link" Disabled="@adoptBusy"
                                        @onclick="@(() => RefreshRowAsync(item))">refresh</Button>
                            </span>
                        }
                        else
                        {
                            <Tag Color="@("green")">in design</Tag>
                        }
                    }
                    @if (unmanagedAudit is not null && unmanagedAudit.UnmanagedIds.Contains(item.Id))
                    {
                        <Tag Color="@("orange")">unmanaged</Tag>
                    }
                    else if (protectedIds.Contains(item.Id))
                    {
                        <Tag Color="@("blue")">protected</Tag>
                    }
                    @if (expandedId == item.Id)
                    {
                        <pre style="max-height:260px;overflow:auto;background:#fafafa;padding:8px;font-size:12px;">@Pretty(item)</pre>
                    }
                </div>
            }
            @if (Filtered().Count() > 200)
            {
                <div style="color:#999;font-size:12px;">showing first 200 of @Filtered().Count() — narrow with facets</div>
            }
        }
    }
    else if (activeTab == "topology")
    {
        <div style="margin-bottom:8px;">
            <select @bind="topoScanId" @bind:after="LoadTopologyAsync">
                @foreach (var scan in completed)
                {
                    <option value="@scan.Id">@(scan.StartedAt.LocalDateTime.ToString("dd.MM HH:mm")) · @scan.Scope · @scan.ResourceCount rows</option>
                }
            </select>
        </div>
        @if (topoScanId is null || topoItems.Count == 0)
        {
            <span>@(completed.Count == 0 ? "No completed scans yet." : "This scan has no snapshot rows.")</span>
        }
        else
        {
            <TopologyView Items="topoItems" Positions="Session.Positions" ChangedIds="topoChanged" />
        }
    }
    else if (activeTab == "exposure")
    {
        @if (exposureScanId is null)
        {
            @if (completed.Count == 0)
            {
                <span>No completed scans yet.</span>
            }
            else
            {
                <select @bind="exposureScanId" @bind:after="LoadExposureAsync">
                    @foreach (var scan in completed)
                    {
                        <option value="@scan.Id">@(scan.StartedAt.LocalDateTime.ToString("dd.MM HH:mm")) · @scan.Scope · @scan.ResourceCount rows</option>
                    }
                </select>
            }
        }
        else
        {
            <div style="display:flex;gap:6px;align-items:center;margin-bottom:8px;">
                <a @onclick="@(() => { exposureScanId = null; exposureFindings = []; })">back</a>
                <Tag Color="@("red")">@exposureFindings.Count(f => f.Severity == ExposureSeverity.Critical) Critical</Tag>
                <Tag Color="@("orange")">@exposureFindings.Count(f => f.Severity == ExposureSeverity.High) High</Tag>
                <Tag Color="@("gold")">@exposureFindings.Count(f => f.Severity == ExposureSeverity.Medium) Medium</Tag>
                <Tag Color="@("blue")">@exposureFindings.Count(f => f.Severity == ExposureSeverity.Low) Low</Tag>
            </div>
            @if (exposureFindings.Count == 0)
            {
                <span>No internet-exposure findings for this scan.</span>
            }
            @foreach (var f in exposureFindings)
            {
                <div style="border-bottom:1px solid #fafafa;padding:4px 0;font-size:13px;">
                    <Tag Color="@ExposureColor(f.Severity)">@f.Severity</Tag>
                    <b>@NameOf(f.ResourceId)</b> <span style="color:#999">@f.ResourceType · @f.Kind</span>
                    <div style="color:#666;">@f.Detail</div>
                    <div style="color:#389e0d;">→ @f.Remediation</div>
                </div>
            }
            @foreach (var cav in AdsToolEngine.ExposureCaveats)
            {
                <div style="font-size:12px;color:#999;">@cav</div>
            }
        }
    }
    else if (activeTab == "reach")
    {
        @if (reachScanId is null)
        {
            @if (completed.Count == 0)
            {
                <span>No completed scans yet.</span>
            }
            else
            {
                <select @bind="reachScanId" @bind:after="LoadReachScanAsync">
                    @foreach (var scan in completed)
                    {
                        <option value="@scan.Id">@(scan.StartedAt.LocalDateTime.ToString("dd.MM HH:mm")) · @scan.Scope · @scan.ResourceCount rows</option>
                    }
                </select>
            }
        }
        else
        {
            <div style="display:flex;gap:6px;align-items:center;margin-bottom:8px;">
                <a @onclick="@(() => { reachScanId = null; reachAnswer = null; })">back</a>
                <select @bind="reachTargetId" @bind:after="RunReachAsync">
                    <option value="">choose a resource…</option>
                    @foreach (var i in reachItems)
                    {
                        <option value="@i.Id">@i.Name · @i.Type</option>
                    }
                </select>
            </div>
            @if (reachAnswer is null)
            {
                <span style="color:#999;">&quot;What can reach this resource?&quot; answered from the snapshot alone: only proven paths, plus what the scan cannot see.</span>
            }
            else
            {
                <div style="margin-bottom:8px;">
                    @if (reachAnswer.InternetReachable)
                    {
                        <Tag Color="@("red")">internet path proven</Tag>
                    }
                    else
                    {
                        <Tag Color="@("default")">no internet path proven in this scan</Tag>
                    }
                    @foreach (var d in reachAnswer.Diagnostics)
                    {
                        <div style="font-size:12px;color:#cf1322;margin-top:4px;">@d.Message</div>
                    }
                </div>
                @foreach (var p in reachAnswer.Paths)
                {
                    <div style="border-bottom:1px solid #fafafa;padding:4px 0;font-size:13px;">
                        @{ var last = p.Hops.Count > 0 ? p.Hops[^1] : NameOf(p.Via); }
                        <Tag Color="@ReachOriginColor(p.Origin)">@ReachOriginLabel(p.Origin)</Tag>
                        <b>@last</b>
                        <div style="color:#666;">Internet → @string.Join(" → ", p.Hops)</div>
                        @foreach (var ev in p.Evidence)
                        {
                            <div style="color:#999;font-size:12px;">@ev</div>
                        }
                    </div>
                }
                @if (reachAnswer.Principals.Count > 0)
                {
                    <div style="margin-top:8px;font-size:13px;"><b>principals (exact-scope assignments):</b> @string.Join(", ", reachAnswer.Principals)</div>
                }
                <div style="margin-top:8px;">
                    @foreach (var cav in reachAnswer.Caveats)
                    {
                        <div style="font-size:12px;color:#999;">@cav</div>
                    }
                </div>
            }
        }
    }
    else if (activeTab == "changes")
    {
        @if (changesScanId is null)
        {
            @if (completed.Count == 0)
            {
                <span>No completed scans yet.</span>
            }
            else
            {
                <select @bind="changesScanId" @bind:after="LoadChangesAsync">
                    @foreach (var scan in completed)
                    {
                        <option value="@scan.Id">@(scan.StartedAt.LocalDateTime.ToString("dd.MM HH:mm")) · @scan.Scope · @scan.ResourceCount rows</option>
                    }
                </select>
            }
        }
        else
        {
            <div style="display:flex;gap:8px;margin-bottom:8px;align-items:center;">
                <a @onclick="@(() => { changesScanId = null; changesRows = []; changesCollected = null; })">back</a>
                <Tooltip Title="@(ArmUnavailable ? $"Sign in / reconnect - collecting calls Azure Resource Graph: {loadError}" : "Query resourcechanges for this scan's subscriptions (last 7 days) and store it in the workspace")">
                    <Button Size="ButtonSize.Small" Disabled="@(ArmUnavailable || changesBusy)"
                            OnClick="CollectFeedAsync">@(changesBusy ? "Collecting…" : "Collect feed (7d)")</Button>
                </Tooltip>
                @if (changesCollected is { } n)
                {
                    <span style="font-size:12px;color:#666;">@n change row(s) collected</span>
                }
            </div>
            @if (changesError is { } cerr)
            {
                <Alert Type="@AlertType.Error" ShowIcon="true" Style="margin-bottom:8px" Message="@cerr" />
            }
            <div style="font-size:12px;color:#666;margin-bottom:6px;">what moved since this scan @(changesSince?.LocalDateTime.ToString("dd.MM HH:mm")) - actors come from the ARG change feed; "unknown actor" where Azure did not attribute the row</div>
            @foreach (var d in changesRows)
            {
                <div style="border-bottom:1px solid #fafafa;padding:4px 0;font-size:13px;">
                    <Tag Color="@DriftColor(d.Status)">@d.Status</Tag>
                    <b>@NameOf(d.ResourceId)</b> <span style="color:#999">@d.ResourceType</span>
                    <span style="color:#999;font-size:12px;">@(d.ChangedAt.LocalDateTime.ToString("dd.MM HH:mm")) · @(string.IsNullOrEmpty(d.ChangedBy) ? "unknown actor" : d.ChangedBy)@(d.ClientType is { Length: > 0 } ct ? $" · {ct}" : "")</span>
                    @if (d.Operation is { Length: > 0 } op)
                    {
                        <div style="color:#666;">@op</div>
                    }
                </div>
            }
            @if (changesRows.Count == 0 && !changesBusy)
            {
                <span>Nothing moved since the scan was taken - or the feed was not collected yet (Collect feed above).</span>
            }
        }
    }
    else if (activeTab == "cost")
    {
        @if (costScanId is null)
        {
            @if (completed.Count == 0)
            {
                <span>No completed scans yet.</span>
            }
            else
            {
                <select @bind="costScanId" @bind:after="LoadCostScopeAsync">
                    @foreach (var scan in completed)
                    {
                        <option value="@scan.Id">@(scan.StartedAt.LocalDateTime.ToString("dd.MM HH:mm")) · @scan.Scope · @scan.ResourceCount rows</option>
                    }
                </select>
            }
        }
        else
        {
            <div style="display:flex;gap:8px;margin-bottom:8px;align-items:center;flex-wrap:wrap;">
                <a @onclick="@(() => { costScanId = null; costResults = []; costSubs = []; })">back</a>
                <span style="font-size:12px;color:#888;">window (days)</span>
                <select @bind="costDays">
                    <option value="7">7</option>
                    <option value="30">30</option>
                </select>
                <span style="font-size:12px;color:#888;">group by</span>
                <select @bind="costDimension">
                    <option value="ResourceGroup">resource group</option>
                    <option value="ServiceFamily">service family</option>
                    <option value="MeterCategory">meter category</option>
                    <option value="Location">location</option>
                </select>
                <Tooltip Title="@(ArmUnavailable ? $"Sign in / reconnect - spend is a live Cost Management query: {loadError}" : "Real Cost Management query per subscription in this scan (needs Cost Management Reader); nothing runs until you click")">
                    <Button Type="ButtonType.Primary" Size="ButtonSize.Small"
                            Disabled="@(ArmUnavailable || costBusy || costSubs.Count == 0)"
                            OnClick="QuerySpendAsync">@(costBusy ? "Querying…" : $"Query spend ({costSubs.Count} sub(s))")</Button>
                </Tooltip>
                <Tooltip Title="digest of the queried spend by owner tag - one pile per owner; untagged and unmatched spend stay named as their own piles. CSV to Downloads, no new Azure call">
                    <Button Size="ButtonSize.Small" Disabled="@(costResults.All(c => c.Result is null))"
                            OnClick="SaveChargebackAsync">Save chargeback digest (CSV)</Button>
                </Tooltip>
            </div>
            <div style="font-size:12px;color:#666;margin-bottom:6px;">
                figures are Azure's own Cost Management numbers for the chosen window - every scope below prints its source, currency and as-of. Not cached, not estimated.
            </div>
            @if (costError is { } kerr)
            {
                <Alert Type="@AlertType.Error" ShowIcon="true" Style="margin-bottom:8px" Message="@kerr" />
            }
            @foreach (var (sub, result, error) in costResults)
            {
                <h4 style="margin:10px 0 4px;">@(subscriptions.FirstOrDefault(s => s.SubscriptionId == sub)?.DisplayName ?? sub)</h4>
                @if (error is { } se)
                {
                    <div style="color:#cf1322;font-size:13px;">@se</div>
                }
                else if (result is { } res)
                {
                    <div style="font-size:12px;color:#999;margin-bottom:4px;">
                        @res.Provenance.Source · @res.Provenance.Scope · endpoint @res.Provenance.Region · currency <b>@(string.IsNullOrEmpty(res.Provenance.Currency) ? "n/a" : res.Provenance.Currency)</b>
                        · window @(res.Provenance.From.ToLocalTime().ToString("dd.MM")) - @(res.Provenance.To.ToLocalTime().ToString("dd.MM")) · fetched @(res.Provenance.AsOf.LocalDateTime.ToString("dd.MM HH:mm"))
                        · total <b>@CostRollup.Total(res.Rows).ToString("0.00")</b>
                    </div>
                    @if (res.Rows.Count == 0)
                    {
                        <div style="font-size:13px;color:#666;">no cost rows for this window (empty subscription or no usage).</div>
                    }
                    else
                    {
                        <table style="width:100%;font-size:13px;">
                            <tr><th>@costDimension</th><th style="text-align:right;">cost</th><th style="text-align:right;">share</th></tr>
                            @foreach (var b in CostRollup.By(res.Rows, CostDim).Take(15))
                            {
                                <tr>
                                    <td>@b.Key</td>
                                    <td style="text-align:right;">@b.Cost.ToString("0.00")</td>
                                    <td style="text-align:right;">@b.Share.ToString("P0")</td>
                                </tr>
                            }
                        </table>
                    }
                }
            }
        }
    }
    else if (activeTab == "stacks")
    {
        <div style="font-size:12px;color:#666;margin-bottom:8px;">
            Read-only view of ARM deployment stacks (v2 12.3): list the stacks of one subscription and compare each stack's managed list against this scan's inventory. This tab issues no mutating call.
        </div>
        @if (stacksScanId is null)
        {
            @if (completed.Count == 0)
            {
                <span>No completed scans yet.</span>
            }
            else
            {
                <select @bind="stacksScanId" @bind:after="LoadStacksScopeAsync">
                    @foreach (var scan in completed)
                    {
                        <option value="@scan.Id">@(scan.StartedAt.LocalDateTime.ToString("dd.MM HH:mm")) · @scan.Scope · @scan.ResourceCount rows</option>
                    }
                </select>
            }
        }
        else
        {
            <div style="display:flex;gap:8px;margin-bottom:8px;align-items:center;flex-wrap:wrap;">
                <a @onclick="@(() => { stacksScanId = null; stackRows = []; stackSubs = []; stackListedSub = null; })">back</a>
                <select @bind="stackSubId">
                    @foreach (var sub in stackSubs)
                    {
                        <option value="@sub">@(subscriptions.FirstOrDefault(s => s.SubscriptionId == sub)?.DisplayName ?? sub)</option>
                    }
                </select>
                <Tooltip Title="@(ArmUnavailable ? $"Sign in / reconnect - listing stacks is a live ARM read: {loadError}" : "Microsoft.Resources/deploymentStacks list at subscription scope (Reader); nothing runs until you click")">
                    <Button Type="ButtonType.Primary" Size="ButtonSize.Small"
                            Disabled="@(ArmUnavailable || stacksBusy || string.IsNullOrEmpty(stackSubId))"
                            OnClick="ListStacksAsync">@(stacksBusy ? "Listing…" : "List stacks")</Button>
                </Tooltip>
            </div>
            @if (stacksError is { } sterr)
            {
                <Alert Type="@AlertType.Error" ShowIcon="true" Style="margin-bottom:8px" Message="@sterr" />
            }
            else if (stackListedSub is not null && !stacksBusy && stackRows.Count == 0)
            {
                <span>No deployment stacks in this subscription.</span>
            }
            @foreach (var row in stackRows)
            {
                <div style="border:1px solid #f0f0f0;border-radius:4px;padding:8px;margin-bottom:8px;">
                    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                        <b>@row.Name</b>
                        <span style="color:#999">@row.ResourceGroup · @row.Location</span>
                        @if (row.State.Length > 0)
                        {
                            <Tag Color="@(row.State.Equals("Succeeded", StringComparison.OrdinalIgnoreCase) ? "green" : "blue")">@row.State</Tag>
                        }
                        @if (row.Drift is { } drift)
                        {
                            @if (drift.IsOutOfSync)
                            {
                                <Tag Color="@("red")">out of sync: @drift.UntrackedCount untracked, @drift.MissingCount missing</Tag>
                            }
                            else
                            {
                                <Tag Color="@("green")">in sync (@row.ManagedCount managed)</Tag>
                            }
                        }
                        else
                        {
                            <Tag Color="@("orange")">managed list unreadable</Tag>
                        }
                        <a @onclick="@(() => stacksExpanded = stacksExpanded == row.Name ? null : row.Name)">@(stacksExpanded == row.Name ? "hide rows" : "show rows")</a>
                    </div>
                    @foreach (var d in row.Diagnostics)
                    {
                        <div style="color:#d48806;font-size:12px;">@d.Code: @d.Message</div>
                    }
                    @if (stacksExpanded == row.Name && row.Drift is { } driftRows)
                    {
                        <table style="width:100%;font-size:12px;margin-top:6px;">
                            <tr><th>managed / live id</th><th>state</th></tr>
                            @foreach (var r in driftRows.Rows)
                            {
                                <tr>
                                    <td>@r.Id</td>
                                    <td><Tag Color="@DriftKindColor(r.Kind)">@r.Kind</Tag></td>
                                </tr>
                            }
                        </table>
                    }
                </div>
            }
        }
    }
    else if (activeTab == "decom")
    {
        <div style="font-size:12px;color:#666;margin-bottom:8px;">
            Plans first: the planner never calls Azure and deletes nothing; locks, RBAC and backups are
            evaluated only as caveats, never as an all-clear. Window execution (below) lands
            can-not-delete locks only - it never deletes anything; purge stays script-side.
        </div>
        @if (decomScanId is null)
        {
            @if (completed.Count == 0)
            {
                <span>No completed scans yet.</span>
            }
            else
            {
                <select @bind="decomScanId" @bind:after="LoadDecomAsync">
                    @foreach (var scan in completed)
                    {
                        <option value="@scan.Id">@(scan.StartedAt.LocalDateTime.ToString("dd.MM HH:mm")) · @scan.Scope · @scan.ResourceCount rows</option>
                    }
                </select>
            }
        }
        else
        {
            <div style="display:flex;gap:8px;margin-bottom:8px;align-items:center;">
                <input style="flex:1;padding:4px;" placeholder="search name / id" @bind="decomSearch" @bind:event="oninput" />
                <a @onclick="@(() => { decomScanId = null; decomPlan = null; decomManifest = null; decomSelected.Clear(); decomRunbook = null; decomWindowRow = null; decomExecRows = null; decomReleaseRows = null; decomExecError = null; decomReleaseError = null; })">back</a>
                <Button Type="ButtonType.Primary" Size="ButtonSize.Small"
                        Disabled="@(decomSelected.Count == 0)" OnClick="RunDecomPreview">Preview teardown (@decomSelected.Count)</Button>
                <Button Size="ButtonSize.Small" Disabled="@(decomPlan is null || DecomConfirmed.Count == 0)"
                        OnClick="SaveManifestAsync">Save retention manifest@(decomManifest is null ? "" : $" ({decomManifest.Rows.Count})")</Button>
                <span style="font-size:12px;color:#888;margin-left:8px;">undo window (days)</span>
                <input type="number" min="1" max="365" @bind="decomPurgeDays" style="width:52px;padding:4px;" />
                <Button Size="ButtonSize.Small" Disabled="@(decomPlan is not { Allowed: true })"
                        OnClick="SaveRunbookAsync">Save runbook</Button>
            </div>

            @foreach (var item in DecomFiltered().Take(200))
            {
                <div style="border-bottom:1px solid #fafafa;padding:2px 0;font-size:13px;">
                    <label>
                        <input type="checkbox" checked="@decomSelected.Contains(item.Id)"
                               @onchange="@(e => ToggleDecom(item.Id, e))" />
                        <b>@item.Name</b> <Tag>@item.ResourceTypeSegment</Tag>
                        <span style="color:#999;font-size:12px;">@item.Location</span>
                    </label>
                </div>
            }
            @if (DecomFiltered().Count() > 200)
            {
                <div style="color:#999;font-size:12px;">showing first 200 - narrow with search</div>
            }

            @if (decomPlan is { } plan)
            {
                <h4 style="margin-top:12px;">Teardown plan</h4>
                @if (plan.Allowed)
                {
                    <div style="color:#389e0d;font-size:13px;margin-bottom:6px;">Nothing refuses - the plan stages in @plan.Stages.Count batch(es). No execution verb exists yet: this stays behind the deploy gates.</div>
                }
                else
                {
                    <div style="color:#cf1322;font-size:13px;margin-bottom:6px;"><b>Refused</b> - something selected is protected or still referenced by a survivor; nothing may proceed.</div>
                }

                @for (var s = 0; s < plan.Stages.Count; s++)
                {
                    <div style="font-size:13px;margin-bottom:4px;"><b>Stage @(s + 1)</b>: @string.Join(", ", plan.Stages[s].Select(NameOf))</div>
                }

                @if (plan.Blockers.Count > 0)
                {
                    <h4>Blockers</h4>
                    @foreach (var b in plan.Blockers)
                    {
                        <div style="border-bottom:1px solid #fafafa;padding:3px 0;font-size:13px;">
                            <Tag Color="@SeverityColor(b.Severity)">@b.Severity</Tag>
                            <b>@NameOf(b.ResourceId)</b> <span style="color:#999">@b.Kind</span>
                            <div style="color:#666;">@b.Detail</div>
                        </div>
                    }
                }

                @if (plan.Impacts.Count > 0)
                {
                    <h4>Impact preview</h4>
                    @foreach (var im in plan.Impacts)
                    {
                        <div style="border-bottom:1px solid #fafafa;padding:3px 0;font-size:13px;">
                            <Tag Color="@SeverityColor(im.Severity)">@im.Severity</Tag>
                            <b>@NameOf(im.ResourceId)</b> <span style="color:#999">@im.Kind</span>
                            <div style="color:#666;">@im.Detail</div>
                        </div>
                    }
                }

                @if (plan.ImplicitChildren.Count > 0)
                {
                    <div style="font-size:12px;color:#faad14;margin-top:6px;">@plan.ImplicitChildren.Count child resource(s) die with their selected parent without being selected: @string.Join(", ", plan.ImplicitChildren.Select(c => NameOf(c.ChildId)).Take(8))@(plan.ImplicitChildren.Count > 8 ? " ..." : "")</div>
                }

                @if (plan.Caveats.Count > 0)
                {
                    <h4>Not evaluated</h4>
                    @foreach (var cav in plan.Caveats)
                    {
                        <div style="font-size:12px;color:#999;">@cav</div>
                    }
                }
            }

            @if (decomRunbook is { } rb && decomPlan is { Allowed: true })
            {
                <h4 style="margin-top:12px;">Window execution</h4>
                <div style="font-size:13px;margin-bottom:6px;">
                    window <b>@rb.Window.WindowId</b> · lock <b>@ProtectionWindowPlanner.LockNameFor(rb.Window.WindowId)</b>
                    · @WindowScopes(rb).Count scope(s) · purge not before <b>@rb.PurgeNotBefore.LocalDateTime.ToString("dd.MM HH:mm")</b>
                </div>
                @if (decomWindowRow is { } row)
                {
                    <Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-bottom:8px"
                           Message="@($"window {row.WindowId} {row.State} since {row.UpdatedAtUtc.LocalDateTime:dd.MM HH:mm}")" />
                }
                @if (decomExecError is { } err)
                {
                    <Alert Type="@AlertType.Error" ShowIcon="true" Style="margin-bottom:8px" Message="@err" />
                }
                @if (decomReleaseError is { } rerr)
                {
                    <Alert Type="@AlertType.Error" ShowIcon="true" Style="margin-bottom:8px" Message="@rerr" />
                }
                <div style="display:flex;gap:8px;margin-bottom:8px;align-items:center;flex-wrap:wrap;">
                    <Tooltip Title="@(ArmUnavailable ? $"Sign in / reconnect - the subscription list could not be fetched: {loadError}" : "Approve the execution hash, then land the window's can-not-delete locks")">
                        <Button Type="ButtonType.Primary" Size="ButtonSize.Small"
                                Disabled="@(decomExecBusy || ArmUnavailable)"
                                OnClick="ApproveAndExecuteAsync">@(decomExecBusy ? "Landing…" : "Approve & land window locks")</Button>
                    </Tooltip>
                    <Tooltip Title="@(decomWindowRow is null ? "No executed window to release yet"
                                    : ArmUnavailable ? $"Sign in / reconnect - the subscription list could not be fetched: {loadError}"
                                    : "Release the window's own locks (the stored scopes, nothing else)")">
                        <Button Size="ButtonSize.Small"
                                Disabled="@(decomWindowRow is null || decomReleaseBusy || ArmUnavailable)"
                                OnClick="ReleaseWindowAsync">@(decomReleaseBusy ? "Releasing…" : "Release window")</Button>
                    </Tooltip>
                </div>
                @if (decomExecRows is { Count: > 0 } rows)
                {
                    <table style="width:100%;font-size:13px;margin-bottom:8px;">
                        <tr><th>scope</th><th>outcome</th><th>detail</th></tr>
                        @foreach (var r in rows)
                        {
                            <tr>
                                <td>@r.Scope</td>
                                <td><Tag Color="@LockOutcomeColor(r.Outcome)">@r.Outcome</Tag></td>
                                <td>@r.Detail</td>
                            </tr>
                        }
                    </table>
                }
                @if (decomReleaseRows is { Count: > 0 } rrows)
                {
                    <table style="width:100%;font-size:13px;margin-bottom:8px;">
                        <tr><th>scope</th><th>outcome</th><th>detail</th></tr>
                        @foreach (var r in rrows)
                        {
                            <tr>
                                <td>@r.Scope</td>
                                <td><Tag Color="@LockOutcomeColor(r.Outcome)">@r.Outcome</Tag></td>
                                <td>@r.Detail</td>
                            </tr>
                        }
                    </table>
                }
                <div style="font-size:12px;color:#666;">Purge never executes from the app — run the exported purge scripts after @rb.PurgeNotBefore.LocalDateTime.ToString("dd.MM HH:mm") (epoch-guarded).</div>
            }
        }
    }
    else if (activeTab == "report" && reportScan is null)
    {
        <span>No completed scan to analyze yet - run one first.</span>
    }
    else
    {
        <div style="margin-bottom:8px;font-size:13px;">
            <b>@reportItems.Count resources</b> scanned @(reportScan?.FinishedAt?.LocalDateTime.ToString("dd.MM HH:mm")) ·
            retirement data as of <b>@(catalog.DataAsOf.LocalDateTime.ToString("yyyy-MM-dd"))</b>
            <Tag Color="@FreshnessColor(catalog.FreshnessAt(DateTimeOffset.UtcNow))">@catalog.FreshnessAt(DateTimeOffset.UtcNow)</Tag>
        </div>
        <div style="margin-bottom:8px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <Button Size="ButtonSize.Small" OnClick="SaveReportAsync">Save report (Markdown)</Button>
            <Button Size="ButtonSize.Small" OnClick="SaveReportBundleAsync">Save report bundle</Button>
            <span style="font-size:12px;color:#999;">findings + retirement watch + exposure + unmanaged + changes since the scan, with sources; the bundle lands report.html + report.json + controls-audit.csv in a Downloads folder</span>
        </div>

        @foreach (var finding in reportFindings)
        {
                <div style="border-bottom:1px solid #fafafa;padding:4px 0;font-size:13px;">
                    <Tag Color="@KindColor(finding.Kind)">@finding.Kind</Tag>
                <b>@NameOf(finding.ResourceId)</b> <span style="color:#999">@finding.ResourceType</span>
                <div style="color:#666;">@finding.Detail</div>
            </div>
        }
        @if (reportFindings.Count == 0)
        {
            <span>No orphaned, idle or broken resources.</span>
        }

        @if (watched.Count > 0)
        {
            <h4>Retiring / retired resources</h4>
            @foreach (var (item, entry) in watched)
            {
                <div style="border-bottom:1px solid #fafafa;padding:4px 0;font-size:13px;">
                    <Tag Color="@("red")">@entry.Status</Tag> <b>@item.Name</b> <span style="color:#999">@item.Type</span>
                    <div style="color:#666;">@entry.Note</div>
                </div>
            }
        }
    }
</div>

@code {
    private string activeTab = "scan";
    private bool loading = true;
    private string loadError = "";
    private IReadOnlyList<SubscriptionInfo> subscriptions = [];
    private readonly HashSet<string> selected = [];
    private IReadOnlyList<DataSourceProbe>? probes;
    private IReadOnlyList<ScanRecord> history = [];
    private List<ScanRecord> completed = [];
    private ScanRecord? resumable;

    private string? browseScanId;
    private string browseSearch = "";
    private string browseProvider = "";
    private string browseLocation = "";
    private string? browseOwner;
    private string? expandedId;
    private List<InventoryItem> browseItems = [];
    private InventoryFacets? facets;

    // Reconcile [58] against the open design: per-row state recomputed from the live
    // canvas snapshot on every browse load / tab switch; null while no design is open.
    private ReconciliationReport? reconcile;
    private Dictionary<string, DesignState> stateById = new(StringComparer.OrdinalIgnoreCase);

    private bool adoptBusy;
    private const int AdoptLimit = 500; // canvas is not virtualized yet ([92])
    private int FilteredCount => Filtered().Count();

    private string? topoScanId;
    private List<InventoryItem> topoItems = [];
    private IReadOnlySet<string>? topoChanged;

    // Phase 9 UI integration (v2 9.1/9.3/9.4/9.5): per-tab workspace-snapshot reads; the only
    // ARM calls on these tabs are Collect feed and Query spend, both gated on ArmUnavailable.
    private string? exposureScanId;
    private IReadOnlyList<ExposureFinding> exposureFindings = [];

    // v2 [16]: reachability answers over one stored snapshot; no ARM call, the same facts the
    // Exposure tab shows, walked backwards to the target.
    private string? reachScanId;
    private List<InventoryItem> reachItems = [];
    private string reachTargetId = "";
    private ReachAnswer? reachAnswer;

    private async Task LoadReachScanAsync()
    {
        reachItems = [];
        reachTargetId = "";
        reachAnswer = null;
        if (reachScanId is null) return;
        var rows = await Session.GetSnapshotsAsync(reachScanId);
        reachItems = rows.Select(ToItem)
            .GroupBy(i => i.Id, StringComparer.OrdinalIgnoreCase).Select(g => g.First())
            .OrderBy(i => i.Name, StringComparer.OrdinalIgnoreCase)
            .ThenBy(i => i.Id, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private void RunReachAsync() =>
        reachAnswer = reachTargetId.Length == 0 ? null : ReachabilityEngine.Analyze(reachTargetId, reachItems);

    private static string ReachOriginColor(ReachOrigin o) => o switch
    {
        ReachOrigin.Internet => "red",
        ReachOrigin.PrivateEndpoint => "blue",
        ReachOrigin.PeerVnet => "gold",
        _ => "cyan",
    };

    private static string ReachOriginLabel(ReachOrigin o) => o switch
    {
        ReachOrigin.Internet => "INTERNET",
        ReachOrigin.PrivateEndpoint => "PRIVATE LINK",
        ReachOrigin.PeerVnet => "PEER VNET",
        _ => "SAME SUBNET",
    };

    private string? changesScanId;
    private bool changesBusy;
    private string? changesError;
    private int? changesCollected;
    private DateTimeOffset? changesSince;
    private IReadOnlyList<LiveDriftItem> changesRows = [];

    private string? costScanId;
    private int costDays = 30;
    private string costDimension = "ResourceGroup";
    private SpendDimension CostDim =>
        System.Enum.TryParse<SpendDimension>(costDimension, out var d) ? d : SpendDimension.ResourceGroup;
    private bool costBusy;
    private string? costError;
    private List<string> costSubs = [];
    private List<(string Sub, ActualSpendResult? Result, string? Error)> costResults = [];

    // v2 12.3 scan plane: read-only Stacks tab - lists deployment stacks in one subscription
    // of a scan and runs CheckDrift against the scan's inventory; issues no mutating verb.
    private string? stacksScanId;
    private List<string> stackSubs = [];
    private string stackSubId = "";
    private bool stacksBusy;
    private string? stacksError;
    private string? stackListedSub;
    private List<StackCard> stackRows = [];
    private string? stacksExpanded;
    private sealed record StackCard(string Name, string ResourceGroup, string Location, string State,
        int ManagedCount, StackDriftReport? Drift, IReadOnlyList<ArmDiagnostic> Diagnostics);

    // 9.3 chips over the Inventory rows; the note names whether protection was judged at all.
    private ManagementAudit? unmanagedAudit;
    private IReadOnlySet<string> protectedIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private string unmanagedPolicyNote = "";
    private bool unmanagedOnly;

    private ScanRecord? reportScan;
    private List<InventoryItem> reportItems = [];
    private IReadOnlyList<AnalysisFinding> reportFindings = [];
    private IReadOnlyList<(InventoryItem Item, DeprecationEntry Entry)> watched = [];
    private DeprecationCatalog catalog = DeprecationCatalog.Seed;

    // Decommission preview [91]: pure read of one scan snapshot - no ARM calls, no evidence
    // fetch, no mutation. The planner's own caveats carry everything it could not check.
    private string? decomScanId;
    private List<InventoryItem> decomItems = [];
    private string decomSearch = "";
    private readonly HashSet<string> decomSelected = new(StringComparer.OrdinalIgnoreCase);
    private DecommissionPlan? decomPlan;
    private RetentionManifest? decomManifest;
    private int decomPurgeDays = 7;

    // v2 13.5 window execution: the runbook (generated by "Save runbook") names the window;
    // the app only lands/releases window-owned can-not-delete locks - purge stays script-side.
    private Runbook? decomRunbook;
    private DecomWindowModel? decomWindowRow;
    private bool decomExecBusy;
    private bool decomReleaseBusy;
    private List<DecomLockRow>? decomExecRows;
    private List<DecomLockRow>? decomReleaseRows;
    private string? decomExecError;
    private string? decomReleaseError;

    /// <summary>The named client of the existing Deploy service; the decom RPCs ride it.</summary>
    private Deploy.DeployClient? _deployClient;
    private Deploy.DeployClient DeployClient =>
        _deployClient ??= grpcFactory.CreateClient<Deploy.DeployClient>("DeployClientWithAuth");

    /// <summary>The drawer's offline/unauthenticated signal: the subscription listing failed
    /// (token broker unresolved or network down) - the ARM-touching verbs stay disabled.</summary>
    private bool ArmUnavailable => loadError.Length > 0;

    private int enabledCount => subscriptions.Count(s => s.State == "Enabled");

    protected override async Task OnInitializedAsync()
    {
        Session.StateChanged += OnSessionChanged;
        await RefreshAsync();
        loading = false;
    }

    // Live subscription listing can block on interactive sign-in; run it after the
    // first render so the drawer opens immediately (history/report tabs usable) and
    // the list fills in once the token broker resolves.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            subscriptions = await Session.GetSubscriptionsAsync();
            foreach (var sub in subscriptions.Where(s => s.State == "Enabled"))
                selected.Add(sub.SubscriptionId);
        }
        catch (Exception e) { loadError = e.Message; }
        StateHasChanged();
    }

    private void OnSessionChanged() => InvokeAsync(async () =>
    {
        await RefreshAsync();
        StateHasChanged();
    });

    private async Task RefreshAsync()
    {
        history = await Session.GetHistoryAsync();
        resumable = await Session.GetResumableAsync();
        completed = history.Where(s => s.Status == "Completed").ToList();
    }

    private async Task SwitchTabAsync(string key)
    {
        activeTab = key;
        if (key == "report" && reportScan is null) await LoadReportAsync();
        if (key == "browse" && browseScanId is null)
        {
            browseScanId = completed.FirstOrDefault()?.Id;
            if (browseScanId is not null) await LoadBrowseAsync();
        }
        if (key == "browse" && browseScanId is not null) await RecomputeReconcileAsync();
        if (key == "topology" && topoScanId is null)
        {
            topoScanId = completed.FirstOrDefault()?.Id;
            await LoadTopologyAsync();
        }
        if (key == "exposure" && exposureScanId is null)
        {
            exposureScanId = completed.FirstOrDefault()?.Id;
            await LoadExposureAsync();
        }
        if (key == "reach" && reachScanId is null)
        {
            reachScanId = completed.FirstOrDefault()?.Id;
            await LoadReachScanAsync();
        }
        if (key == "changes" && changesScanId is null)
        {
            changesScanId = completed.FirstOrDefault()?.Id;
            await LoadChangesAsync();
        }
        if (key == "decom") await LoadDecomWindowRowAsync();
    }

    private async Task LoadReportAsync()
    {
        reportScan = await Session.Scans.GetLatestCompletedAsync();
        catalog = DeprecationCatalog.Load(null);
        if (reportScan?.Snapshots is { Count: > 0 } snaps)
        {
            reportItems = snaps.Select(ToItem).ToList();
            reportFindings = OrphanAnalyzer.Analyze(reportItems);
            watched = catalog.Watch(reportItems);
        }
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        if (e.Value is true or "true")
            foreach (var s in subscriptions.Where(s => s.State == "Enabled")) selected.Add(s.SubscriptionId);
        else selected.Clear();
    }

    private void Toggle(string id, ChangeEventArgs e)
    {
        if (e.Value is true or "true") selected.Add(id); else selected.Remove(id);
    }

    private Task StartAsync() => Session.StartScanAsync(selected.ToList());
