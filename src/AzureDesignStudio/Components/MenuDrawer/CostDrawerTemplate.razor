@inherits FeedbackComponent<string, string>
@using AzureDesignStudio.Core.Cost
@using AzureDesignStudio.Core.Models
@using AzureDesignStudio.Services
@using System.Globalization
@using System.Text.Json
@inject CostService _costService

<div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
    <Select DataSource="AzureRegions.AllRegions" @bind-Value="@_region"
        LabelName="@nameof(Region.Name)" ValueName="@nameof(Region.Value)"
        Placeholder="Select the region" DefaultActiveFirstItem="false" Size="@InputSize.Small"
        EnableSearch>
    </Select>
    <Select TItem="CurrencyOption" TItemValue="string" DataSource="@Currencies" @bind-Value="@_currency"
        LabelName="@nameof(CurrencyOption.Name)" ValueName="@nameof(CurrencyOption.Value)"
        DefaultActiveFirstItem="false" Size="@InputSize.Small">
    </Select>
    <Button Type="@ButtonType.Primary" OnClick="Calculate" Disabled="@_busy" Loading="@_busy">Calculate</Button>
</div>

@if (_error is not null)
{
    <Alert Type="@AlertType.Error" ShowIcon="true">
        <MessageTemplate>
            @_error
        </MessageTemplate>
    </Alert>
}

@if (_result is not null)
{
    @if (_result.TotalMonthly is null)
    {
        <span style="font-size:16px;">No computable monthly costs.</span>
    }
    else
    {
        <span style="font-size:16px;"><b>Total: @CostEstimator.FormatMoney(_result.TotalMonthly, _result.Currency) / month</b></span>
    }
    <br />
    <br />
    @if (_result.UsedFallback)
    {
        <Alert Type="@AlertType.Warning" ShowIcon="true">
            <MessageTemplate>
                Prices from offline snapshot (pricing proxy unreachable).
            </MessageTemplate>
        </Alert>
        <br />
    }
    <AntList TItem="CostLine" DataSource="@_result.Lines" Size="@ListSize.Small" Split="true">
        <ChildContent Context="item">
            <ListItem Style="padding:8px 0px;">
                <div style="display:flex;align-items:baseline;gap:8px;">
                    <Tag Color="@StatusColor(item.Result.Status)">@item.Result.Status</Tag>
                    <span><b>@item.NodeName</b> — @item.ServiceLabel@SkuSuffix(item)</span>
                    <span style="margin-left:auto;white-space:nowrap;">@FormatValue(item)</span>
                </div>
            </ListItem>
        </ChildContent>
    </AntList>
    @if (_result.Breakdown.Count > 0)
    {
        <br />
        <span style="font-size:16px;">Breakdown by service:</span>
        <br />
        <AntList TItem="CostBreakdownLine" DataSource="@_result.Breakdown" Size="@ListSize.Small" Split="true">
            <ChildContent Context="item">
                <ListItem Style="padding:8px 0px;">
                    <span>@item.ServiceLabel: @CostEstimator.FormatMoney(item.Monthly, _result.Currency)</span>
                </ListItem>
            </ChildContent>
        </AntList>
    }
}

@code {
    private List<CostNodeInput> nodes = new();
    private string _region = "westus2";
    private string _currency = "USD";
    private bool _busy;
    private string? _error;
    private CostEstimateResult? _result;

    private record CurrencyOption(string Name, string Value);

    private static readonly List<CurrencyOption> Currencies = new()
    {
        new CurrencyOption("USD", "USD"),
        new CurrencyOption("EUR", "EUR"),
        new CurrencyOption("GBP", "GBP"),
    };

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Options))
            nodes = JsonSerializer.Deserialize<List<CostNodeInput>>(Options, new JsonSerializerOptions(JsonSerializerDefaults.Web)) ?? new();
    }

    private async Task Calculate()
    {
        _busy = true;
        _error = null;
        try
        {
            _result = await _costService.EstimateAsync(nodes, _region, _currency);
        }
        catch (Exception ex)
        {
            _error = $"Cost estimate failed: {ex.Message}";
            _result = null;
        }
        finally
        {
            _busy = false;
        }
    }

    private string FormatValue(CostLine line) => line.Result.Status switch
    {
        CostStatus.Computed => CostEstimator.FormatMoney(line.Result.Monthly, _result?.Currency ?? "USD"),
        CostStatus.UsageBased => $"{line.Result.UnitPrice?.ToString("G4", CultureInfo.InvariantCulture)} per {line.Result.Unit}",
        _ => line.Result.Note ?? "-",
    };

    private static string SkuSuffix(CostLine line) => line.Result.Sku is null ? "" : $" ({line.Result.Sku})";

    private static string StatusColor(CostStatus status) => status switch
    {
        CostStatus.Computed => "green",
        CostStatus.UsageBased => "blue",
        CostStatus.Unavailable => "orange",
        _ => "default",
    };
}
