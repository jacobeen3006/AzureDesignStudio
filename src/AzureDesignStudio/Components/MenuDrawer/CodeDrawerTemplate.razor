@using System.Text
@using AzureDesignStudio.Models
@using AzureDesignStudio.Services
@inherits FeedbackComponent<CodeDrawerContent, string>
@inject IJSRuntime JS
@inject DeployGrpcService _deployService
@inject MessageService _messageService
@implements IDisposable

<Affix TargetSelector=".ant-drawer-body" OnChange="HandleAffixChange">
    <div style="@_buttonStyle">
        @if (_showDeployButton)
        {
            <Button OnClick="HandleDeploy" NoSpanWrap>
                <Icon Component="@_azureIcon" />
                <span>Deploy</span>
            </Button>
        }
        <Button Icon="download" OnClick="HandleDownload">Download</Button>
    </div>
</Affix>
<pre><code class="@_codeClass">
    @_drawerContent.Content
</code></pre>

<Modal Title="Deployment Parameters" Visible="@_showDeployParams" MaskClosable="@false" OnOk="@ParamsFormOk" OnCancel="@ParamsFormCancel">
    <Form Model="_deployParams" @ref="@_paramsForm" LabelCol="@(new ColLayoutParam { Span = 8 })" WrapperCol="@(new ColLayoutParam { Span = 16 })"
          Loading="@_paramFormLoading" OnFinish="ParamsFormFinish">
        <FormItem Label="Resource Group">
            <SimpleSelect DataSource="@_resourceGroupNames" @bind-Value="@context.ResourceGroup" SortByLabel="@SortDirection.Ascending" />
        </FormItem>
        <FormItem Label="Template parameters (JSON)">
            <InputTextArea rows="6" @bind-Value="@context.ParametersJson" />
        </FormItem>
    </Form>
</Modal>

<Modal Title="Review what will change (What-If)" Visible="@_showWhatIfReview" MaskClosable="@false"
       OkText="@(_deployAsStack ? "Approve & deploy as stack" : "Approve & deploy")" OnOk="@ApproveAndDeployAsync" OnCancel="@CancelWhatIf">
    @if (_retryTemplate is not null)
    {
        <Alert Type="@AlertType.Info" Message="Targeted retry: only the failed resources will be previewed and deployed - not the full template." ShowIcon="true" Style="margin-bottom:8px" />
    }
    @if (_whatIfLoading)
    {
        <p><Icon Type="loading" Theme="@IconThemeType.Outline" /> Running what-if against @_deployParams.ResourceGroup. This can take a minute...</p>
    }
    else if (_whatIfError is not null)
    {
        <Alert Type="@AlertType.Error" Message="@_whatIfError" ShowIcon="true" />
    }
    else if (_whatIfResult is not null)
    {
        <p>
            <Tag Color="@("green")">@_whatIfResult.Creates create</Tag>
            <Tag Color="@("blue")">@_whatIfResult.Modifies modify</Tag>
            <Tag Color="@(_whatIfResult.Deletes > 0 ? "red" : "default")">@_whatIfResult.Deletes delete</Tag>
        </p>
        @if (_whatIfResult.Deletes > 0)
        {
            <Alert Type="@AlertType.Error" Message="What-If predicts deletes. This version never deploys delete-bearing plans." ShowIcon="true" Banner="true" />
        }
        else if (_whatIfChanges.Count == 0)
        {
            <p>No changes predicted for this template.</p>
        }
        <ul>
            @foreach (var change in _whatIfChanges)
            {
                <li>
                    <strong>@change.ChangeType</strong> @change.ResourceId
                    @if (change.Delta > 0)
                    {
                        <span> · @change.Delta property change(s)</span>
                    }
                    @if (change.Before is not null || change.After is not null)
                    {
                        <details>
                            <summary>resource payload</summary>
                            @if (change.Before is not null)
                            {
                                <pre>@change.Before@(change.BeforeTruncated ? " …[truncated]" : "")</pre>
                            }
                            @if (change.After is not null)
                            {
                                <pre>@change.After@(change.AfterTruncated ? " …[truncated]" : "")</pre>
                            }
                        </details>
                    }
                </li>
            }
        </ul>
        <ul>
            @foreach (var caveat in _whatIfResult.Caveats.Split('\n', StringSplitOptions.RemoveEmptyEntries))
            {
                <li><em>@caveat</em></li>
            }
        </ul>
        <p>Plan <code>@_whatIfResult.PlanHash</code> - approving records @(_approverName ?? "your signed-in identity") as the named approver; the review expires after 15 minutes and applies exactly once.</p>
        @if (WhatIfDeployAllowed)
        {
            <Divider />
            <div style="display:flex;gap:8px;align-items:center">
                <Switch @bind-Value="@_deployAsStack" Size="@InputSize.Small" />
                <span>Deploy as a <strong>deployment stack</strong></span>
            </div>
            @if (_deployAsStack)
            {
                <div style="margin-top:8px;display:flex;gap:8px;align-items:center">
                    <span>Stack name</span>
                    <Input @bind-Value="@_stackName" Style="width:240px" />
                </div>
                <p style="margin-top:6px"><em>Resources the stack later stops managing are detached, never deleted. The plan hash, approval and audit trail are identical to a plain deploy.</em></p>
            }
        }
    }
</Modal>

<Modal Title="Deploy to Azure" Visible="@_showDeployStatus" MaskClosable="@false" Closable="false" 
    Footer="@_modalFooter" OnOk="CloseDeployStatus">
    <Steps Direction="@StepsDirection.Vertical" Current="@_stepsStatus.CurrentStep" Status="@GetStepsStatus(_stepsStatus.Status)">
        <Step Title="@((_stepsStatus.CurrentStep == 0 && _stepsStatus.Status == "started") ? "Starting" : ((_stepsStatus.CurrentStep == 0 && _stepsStatus.Status == "error") ? "Failed" : "Started"))"
              Description="@((_stepsStatus.CurrentStep == 0 && _stepsStatus.Status == "started") ? "The deployment is starting..." : ((_stepsStatus.CurrentStep == 0 && _stepsStatus.Status == "error") ? _stepsStatus.ErrorMessage : "The deployment has started."))"
              Icon="@((_stepsStatus.CurrentStep == 0 && _stepsStatus.Status == "started") ? "loading" : "")" />
        <Step Title="@((_stepsStatus.CurrentStep == 1 && _stepsStatus.Status == "unknown") ? "Outcome Unknown" : ((_stepsStatus.CurrentStep == 1 && _stepsStatus.Status == "error") ? "Failed" : "In Progress"))"
              Description="@((_stepsStatus.CurrentStep == 1 && _stepsStatus.Status == "unknown") ? _stepsStatus.ErrorMessage : ((_stepsStatus.CurrentStep == 1 && _stepsStatus.Status == "error") ? _stepsStatus.ErrorMessage : "The deployment is running."))"
              Icon="@((_stepsStatus.CurrentStep == 1 && _stepsStatus.Status == "process") ? "loading" : "")" />
        <Step Title="@((_stepsStatus.CurrentStep == 2 && _stepsStatus.Status == "finish") ? "Completed" : ((_stepsStatus.CurrentStep == 2 && _stepsStatus.Status == "error") ? "Failed" : "Waiting"))"
              Description="@((_stepsStatus.CurrentStep == 2 && _stepsStatus.Status == "finish") ? "The deployment has completed successfully." : ((_stepsStatus.CurrentStep == 2 && _stepsStatus.Status == "error") ? _stepsStatus.ErrorMessage : "Waiting for the result."))" />
    </Steps>
    <Divider />
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
        <span>
            <strong>Per-resource apply state</strong>
            @if (!string.IsNullOrEmpty(_monitorStatus))
            {
                <Tag Color="@StateColor(_monitorStatus)">@_monitorStatus</Tag>
            }
        </span>
        <span>
            <Button Size="@ButtonSize.Small" Icon="redo" Disabled="@(!CanRetryNow)" OnClick="RetryFailedAsync" Style="margin-right:8px">Retry failed</Button>
            <Button Size="@ButtonSize.Small" Icon="@(_monitorLoading ? "loading" : "sync")" OnClick="RefreshMonitorAsync">Refresh</Button>
        </span>
    </div>
    @if (_monitorRows.Count == 0)
    {
        <p>@(_monitorNotice.Length == 0 ? "No per-resource operations reported yet." : _monitorNotice)</p>
    }
    else
    {
        @if (_monitorNotice.Length > 0)
        {
            <Alert Type="@AlertType.Warning" Message="@_monitorNotice" ShowIcon="true" Style="margin-bottom:8px" />
        }
        <ul>
            @foreach (var row in _monitorRows)
            {
                <li>
                    <code>@row.ResourceKey</code>
                    <Tag Color="@StateColor(row.State)">@row.State</Tag>
                    @if (row.StatusCode.Length > 0)
                    {
                        <span> · @row.StatusCode</span>
                    }
                    @if (DateTimeOffset.TryParse(row.TimestampUtc, out var stamp))
                    {
                        <span> · @stamp.ToLocalTime().ToString("HH:mm:ss")</span>
                    }
                </li>
            }
        </ul>
    }
</Modal>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; } = null!;
    // Azure icon
    private static readonly RenderFragment _azureIcon =
    @<svg id="bf656193-e6ca-4f9a-a1e3-1cf0316f5b36" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" 
        fill="currentColor" class="icon" viewBox="0 0 18 18">
        <path d="M6.2678.7255v0h5.4894a1.249,1.249,0,0,1,1.1834.85l4.7422,14.0511a1.2489,1.2489,0,0,1-1.1834,1.6483H11.1467V17.27c-.0367.0032-.0739.0047-.1116.0047h-.0205a1.2489,1.2489,0,0,1-.7448-.2463L6.7813,14.4367,6.11,16.425a1.249,1.249,0,0,1-1.1834.85H1.5006A1.249,1.249,0,0,1,.3172,15.6262L5.0594,1.5751a1.249,1.249,0,0,1,1.1834-.85ZM5.7869,12.5311l5.0415,3.745a.3122.3122,0,0,0,.1862.0617h.0205a.3122.3122,0,0,0,.2958-.4122L8.7768,8.3577,7.755,11.0024l-.1158.3H4.1515Zm10.7125,3.8067H12.2453a1.2381,1.2381,0,0,0-.0268-.7117L7.5057,1.6621h4.2515a.3124.3124,0,0,1,.2958.2124l4.7423,14.0511A.3123.3123,0,0,1,16.4994,16.3378Z" fill-rule="evenodd" />
        </svg>
    ;
    private RenderFragment _modalFooter =@<OneButtonModalFooter />;
}
