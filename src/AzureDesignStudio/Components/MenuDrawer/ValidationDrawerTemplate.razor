@inherits FeedbackComponent<string, string>
@using AzureDesignStudio.Core.Validation

<div style="display:flex;justify-content:space-between;align-items:baseline;">
    <b style="font-size:16px;">Validation</b>
    <span>@issues.Count issue(s)</span>
</div>
@if (issues.Count == 0)
{
    <span style="font-size:16px;">No issues found. The design passes all validation rules.</span>
}
else
{
    <AntList TItem="ValidationIssue" DataSource="@issues" Size="@ListSize.Small" Split="true">
        <ChildContent Context="item">
            <ListItem Style="padding:8px 0px;">
                <div style="display:flex;align-items:baseline;gap:8px;">
                    <Tag Color="@SeverityColor(item.Severity)">@item.Severity</Tag>
                    <span><b>@item.NodeName</b> — @item.Message</span>
                </div>
            </ListItem>
        </ChildContent>
    </AntList>
}

@if (findings.Count > 0)
{
    <div style="display:flex;justify-content:space-between;align-items:baseline;margin-top:24px;">
        <b style="font-size:16px;">Well-Architected advice</b>
        <span>@findings.Count finding(s)</span>
    </div>
    @foreach (var group in PillarGroups())
    {
        <div style="font-weight:600;margin:12px 0 4px;">@PillarName(group.Key)</div>
        <AntList TItem="LintFinding" DataSource="@group.ToList()" Size="@ListSize.Small" Split="true">
            <ChildContent Context="item">
                <ListItem Style="padding:8px 0px;">
                    <div style="display:flex;align-items:baseline;gap:8px;">
                        <Tag Color="@SeverityColor(item.Severity)">@item.Severity</Tag>
                        <span>
                            <b>@item.NodeName</b> — @item.Message
                            <a href="@item.LearnUrl" target="_blank" rel="noopener noreferrer">Learn more ↗</a>
                        </span>
                    </div>
                </ListItem>
            </ChildContent>
        </AntList>
    }
}

@code {
    private IReadOnlyList<ValidationIssue> issues = Array.Empty<ValidationIssue>();
    private IReadOnlyList<LintFinding> findings = Array.Empty<LintFinding>();

    protected override void OnInitialized()
    {
        var report = ValidationReport.Parse(Options);
        issues = report.Issues;
        findings = report.Findings;
    }

    // Findings arrive ordered by pillar; GroupBy keeps that order.
    private IEnumerable<IGrouping<LintPillar, LintFinding>> PillarGroups() => findings.GroupBy(f => f.Pillar);

    private static string PillarName(LintPillar pillar) =>
        System.Text.RegularExpressions.Regex.Replace(pillar.ToString(), "(?<=[a-z])(?=[A-Z])", " ");

    private static string SeverityColor(ValidationSeverity severity) => severity switch
    {
        ValidationSeverity.Error => "red",
        ValidationSeverity.Warning => "orange",
        _ => "blue",
    };
}
