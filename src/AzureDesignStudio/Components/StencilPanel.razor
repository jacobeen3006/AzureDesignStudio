@using AzureDesignStudio.Core.Common
@using AzureDesignStudio.Models
@using AzureDesignStudio.Services
@using System.Reflection
@inject AdsContext adsContext
@inject ConfirmService confirmService

<div class="ads-stencil-panel">
    <div class="ads-icon-panel-container">
        <Tabs DefaultActiveKey="2" TabPosition="TabPosition.Left">
            <TabBarExtraContent>
		        <Button Shape="@ButtonShape.Circle" Icon="question" Size="@ButtonSize.Small" OnClick="OpenAbout"></Button>
	        </TabBarExtraContent>
            <ChildContent>
                @foreach(var panel in _panels)
                {
                    <TabPane Key="@panel.Key">
                        <TabTemplate>
                            <span class="ads-category-tab">
                                <IconComponent IconPath="@panel.IconPath" />
                                <span class="ads-category-label">@panel.Name</span>
                            </span>
                        </TabTemplate>
                        <ChildContent>
                            @foreach (var stencil in adsContext.AllStencils.Where(s => s.Category == panel.Category))
                            {
                                <Stencil Model=@stencil />
                            }
                        </ChildContent>
                    </TabPane>
                }
            </ChildContent>
        </Tabs>
        <div class="ads-stencil-hint"
             title="Subnets belong inside a Virtual Network; Web App needs an App Service Plan; App Gateway, Firewall and Bastion need a Subnet; Public IP cannot be inside a Virtual Network.">
            Drag a resource onto the canvas. Some types need a parent frame.
        </div>
    </div>
</div>

