@using AutoMapper
@using AzureDesignStudio.Services
@inject ILogger<DiagramPanel> logger
@inject AdsContext adsContext
@inject MessageService messageService
@inject DrawerService drawerService
@inject ModalService modalService
@inject IHttpClientFactory _clientFactory
@inject IMapper _mapper

<div class="ads-diagram-wrapper" ondragover="event.preventDefault();" @ondragover:preventDefault @ondrop="HandleDrop">
    <CascadingValue Value="@diagram">
        <div class="ads-diagram-container">
            <DiagramCanvas Class="ads-diagram-canvas"></DiagramCanvas>
        </div>
    </CascadingValue>
    @if (guideX is not null)
    {
        <div class="ads-guide ads-guide-v" style="@($"left:{diagram.Pan.X + guideX.Value * diagram.Zoom}px")"></div>
    }
    @if (guideY is not null)
    {
        <div class="ads-guide ads-guide-h" style="@($"top:{diagram.Pan.Y + guideY.Value * diagram.Zoom}px")"></div>
    }
    <DiagramNavigator />
    <div class="ads-context-menu @(showCtxMenu ? "ads-context-menu-active" : "")">
        <div class="ads-context-btn-container">
            <Button Type="@ButtonType.Text" Class="ads-context-btn" Icon="Edit" OnClick="_=>OpenNodeDrawer()" Disabled="@(!nodeEditable)">
                Edit
            </Button>
            <Button Type="@ButtonType.Text" Class="ads-context-btn" Icon="Delete" OnClick="_=>ConfirmDelete()">
                Delete
            </Button>
            <Button Type="@ButtonType.Text" Class="ads-context-btn" Icon="undo" OnClick="_=>Undo()" Disabled="@(!undoAvailable)">
                Undo
            </Button>
            <Button Type="@ButtonType.Text" Class="ads-context-btn" Icon="redo" OnClick="_=>Redo()" Disabled="@(!redoAvailable)">
                Redo
            </Button>
        </div>
    </div>
</div>

@code {
    private void ConfirmDelete()
    {
        RenderFragment icon =
    @<Icon Type="exclamation-circle" Theme="@IconThemeType.Outline"></Icon>
    ;

        modalService.Confirm(new ConfirmOptions()
        {
            Title = "Delete the selected node(s)?",
            Icon = icon,
            Content = "The node(s) will be deleted. You can restore them with Undo (Ctrl+Z).",
            OnCancel = (e) =>
            {
                return Task.CompletedTask;
            },
            OnOk = (e) =>
            {
                diagram.DeleteSelectedModels();
                RefreshDiagram();
                return Task.CompletedTask;
            },
            OkType = ButtonType.Primary,
        });
    }

    private bool undoAvailable;
    private bool redoAvailable;

    private void Undo()
    {
        diagram.History.Undo();
        RefreshDiagram();
    }

    private void Redo()
    {
        diagram.History.Redo();
        RefreshDiagram();
    }

    private void HandleHistoryStateChanged()
    {
        InvokeAsync(() =>
        {
            if (diagram is null)
                return;

            undoAvailable = diagram.History.CanUndo;
            redoAvailable = diagram.History.CanRedo;
            StateHasChanged();
        });
    }

    private double? guideX, guideY;

    private void HandleGuideChanged(double? x, double? y)
    {
        InvokeAsync(() =>
        {
            guideX = x;
            guideY = y;
            StateHasChanged();
        });
    }
}
