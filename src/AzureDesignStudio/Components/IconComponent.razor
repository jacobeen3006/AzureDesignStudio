@inject IHttpClientFactory clientFactory

<Icon Component="component"></Icon>

@code {
    [Parameter]
    public string IconPath { get; set; } = null!;

    RenderFragment component =
    @<div></div>
    ;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(IconPath))
        {
            var httpClient = clientFactory.CreateClient("AzureDesignStudio.ResourceAccess");
            string? svgMarkup;
            try
            {
                svgMarkup = await httpClient.GetStringAsync(IconPath);
            }
            catch (HttpRequestException)
            {
                // Decorative icon unavailable (e.g. local run without CDN assets); render empty.
                return;
            }
            component = builder =>
            {
                builder.AddMarkupContent(0, svgMarkup);
            };
        }

        await base.OnInitializedAsync();
    }
}
