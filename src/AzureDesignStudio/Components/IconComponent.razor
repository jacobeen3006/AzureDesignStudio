@inject IHttpClientFactory clientFactory

<Icon Component="component"></Icon>

@code {
    [Parameter]
    public string IconPath { get; set; } = null!;

    RenderFragment component =
    @<div></div>
    ;

    string? fetchedPath;

    // Fetch after first render: WebView hosts initialize NavigationManager (and thus
    // HttpClient base addresses) only after the initial render pass.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!string.IsNullOrEmpty(IconPath) && fetchedPath != IconPath)
        {
            var httpClient = clientFactory.CreateClient("AzureDesignStudio.ResourceAccess");
            string? svgMarkup;
            try
            {
                svgMarkup = await httpClient.GetStringAsync(IconPath);
            }
            catch (HttpRequestException)
            {
                // Decorative icon unavailable (e.g. local run without CDN assets); render empty.
                return;
            }
            fetchedPath = IconPath;
            component = builder =>
            {
                builder.AddMarkupContent(0, svgMarkup);
            };
            StateHasChanged();
        }

        await base.OnAfterRenderAsync(firstRender);
    }
}
