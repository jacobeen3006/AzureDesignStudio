{
  "AzureAd": {
    "Authority": "https://login.microsoftonline.com/common",
    "ClientId": "<client id>",
    "ValidateAuthority": true
  },
  "ServerScope": "api://<server client id>/Server.Access",
  "ResourceRoot": "/",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "BlazorApplicationInsights.ApplicationInsightsLoggerProvider": {
      "LogLevel": {
        "Default": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  }
}