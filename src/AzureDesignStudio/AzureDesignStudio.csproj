<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
	<PublishTrimmed>true</PublishTrimmed>
	<!-- AOT unsupported in Debug publish (WasmApp.Common.targets); Release-only. -->
	<RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Build-time compression runs before ServiceWorkerAssetsManifest generation,
         producing dangling precompressed endpoints (empty 200 bodies). Exclude the
         generated service-worker files; they are served uncompressed. -->
    <CompressionExcludePatterns>$(CompressionExcludePatterns);**/service-worker*.js;</CompressionExcludePatterns>
  </PropertyGroup>
  <PropertyGroup>
    <!-- AutoMapper 12.0.1 GHSA-rvv3-g6hj-g44x (DoS via uncontrolled recursion) accepted:
         mappings are shallow node DTOs; 13+ requires a commercial license key. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AntDesign" Version="1.6.2" />
    <PackageReference Include="AutoMapper" Version="12.0.1" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.0" />
    <PackageReference Include="Azure.Bicep.Decompiler" Version="0.48.1" />
    <PackageReference Include="BlazorApplicationInsights" Version="2.2.2" />
    <PackageReference Include="Google.Protobuf" Version="3.28.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.66.0" />
    <PackageReference Include="Z.Blazor.Diagrams" Version="3.0.4.1" />
    <PackageReference Include="Grpc.Net.Client.Web" Version="2.66.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.66.0" />
    <!-- direct pin: transitive via Azure.Bicep.Decompiler -> Microsoft.Windows.Compatibility; >=10.0.0 <=10.0.12 carries GHSA-2fmv-rv2c-59x7 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Grpc.Tools" Version="2.66.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Authentication.WebAssembly.Msal" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.12" />
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.6.146">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" Version="19.2.4" />
    <!-- Mono AOT compiles System.Private.Windows.Core (pulled in by the Bicep decompiler via
         Microsoft.Windows.Compatibility) and fails to load its System.Formats.Nrbf reference
         unless that assembly is in the app payload. -->
    <PackageReference Include="System.Formats.Nrbf" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzureDesignStudio.Core\AzureDesignStudio.Core.csproj" />
    <ProjectReference Include="..\AzureDesignStudio.SharedModels\AzureDesignStudio.SharedModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

	<ItemGroup>
		<!-- Don't trim this assembly. https://github.com/dotnet/aspnetcore/issues/33312 -->
		<TrimmerRootAssembly Include="Microsoft.Authentication.WebAssembly.Msal" />
		<!-- For Bicep decompiler to work when trimmed. -->
		<TrimmerRootAssembly Include="System.Collections.Immutable" />
	</ItemGroup>

	<!-- Azure.Bicep.Decompiler pulls Microsoft.VisualStudio.Threading.Analyzers in transitively;
	     that is Bicep tooling internals - it must not police this project's threading style.
	     Dropped from every compilation (targets run after NuGet populates @(Analyzer)). -->
	<Target Name="DropForeignThreadingAnalyzers" BeforeTargets="CoreCompile">
		<ItemGroup>
			<Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'Microsoft.VisualStudio.Threading.Analyzers'" />
		</ItemGroup>
	</Target>
</Project>
