<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
	<PublishTrimmed>true</PublishTrimmed>
	<!-- AOT unsupported in Debug publish (WasmApp.Common.targets); Release-only. -->
	<RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Build-time compression runs before ServiceWorkerAssetsManifest generation,
         producing dangling precompressed endpoints (empty 200 bodies). Exclude the
         generated service-worker files; they are served uncompressed. -->
    <CompressionExcludePatterns>$(CompressionExcludePatterns);**/service-worker*.js;</CompressionExcludePatterns>
  </PropertyGroup>
  <PropertyGroup>
    <!-- AutoMapper 12.0.1 GHSA-rvv3-g6hj-g44x (DoS via uncontrolled recursion) accepted:
         mappings are shallow node DTOs; 13+ requires a commercial license key. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AntDesign" />
    <PackageReference Include="AutoMapper" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" />
    <PackageReference Include="Azure.Bicep.Decompiler" />
    <PackageReference Include="BlazorApplicationInsights" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Z.Blazor.Diagrams" />
    <PackageReference Include="Grpc.Net.Client.Web" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <!-- direct pin: transitive via Azure.Bicep.Decompiler -> Microsoft.Windows.Compatibility; >=10.0.0 <=10.0.12 carries GHSA-2fmv-rv2c-59x7 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <!-- Pin: this graph is one of only two that resolve transitive System.Security.Cryptography.Xml 10.0.10 (three high advisories); 10.0.13 is the first clean servicing release — a direct reference is the narrow fix, transitive pinning would fail restore with NU1109. -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Authentication.WebAssembly.Msal" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" />
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" />
    <!-- Mono AOT compiles System.Private.Windows.Core (pulled in by the Bicep decompiler via
         Microsoft.Windows.Compatibility) and fails to load its System.Formats.Nrbf reference
         unless that assembly is in the app payload. -->
    <PackageReference Include="System.Formats.Nrbf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzureDesignStudio.Core\AzureDesignStudio.Core.csproj" />
    <ProjectReference Include="..\AzureDesignStudio.SharedModels\AzureDesignStudio.SharedModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

	<ItemGroup>
		<!-- Don't trim this assembly. https://github.com/dotnet/aspnetcore/issues/33312 -->
		<TrimmerRootAssembly Include="Microsoft.Authentication.WebAssembly.Msal" />
		<!-- For Bicep decompiler to work when trimmed. -->
		<TrimmerRootAssembly Include="System.Collections.Immutable" />
	</ItemGroup>

	<!-- Azure.Bicep.Decompiler pulls Microsoft.VisualStudio.Threading.Analyzers in transitively;
	     that is Bicep tooling internals - it must not police this project's threading style.
	     Dropped from every compilation (targets run after NuGet populates @(Analyzer)). -->
	<Target Name="DropForeignThreadingAnalyzers" BeforeTargets="CoreCompile">
		<ItemGroup>
			<Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'Microsoft.VisualStudio.Threading.Analyzers'" />
		</ItemGroup>
	</Target>
</Project>
