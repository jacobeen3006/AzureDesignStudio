<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AzureDesignStudio.Discovery</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- TokenCredential seam; the host (Desktop) supplies the concrete credential (AdsTokenBroker). -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Narrow seam: offline tests assert the what-if wire-body contract directly. -->
    <InternalsVisibleTo Include="AzureDesignStudio.Core.Tests" />
  </ItemGroup>

</Project>
